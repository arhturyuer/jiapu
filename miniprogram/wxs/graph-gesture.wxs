    state.x += first.x - state.first.x;
    state.y += first.y - state.first.y;
  }
  state.first = first;
  paint(owner, state);
  return false;
}
function end(event, owner) {
  var instance = surface(owner);
  if (!instance) return;
  var state = instance.getState();
