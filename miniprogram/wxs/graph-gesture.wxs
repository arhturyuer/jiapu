}
function configure(value, oldValue, owner, instance) {
  if (!value) return;
  var state = instance.getState();
  if (state.active) state.blocked = true;
  if (value.disabled || state.disabled) {
    state.blocked = false;
    state.suppressTap = true;
  }
  state.active = false;
  state.version = value.version;
  state.x = value.x;
  state.y = value.y;
  state.scale = value.scale;
  state.left = value.left || 0;
  state.top = value.top || 0;
  state.minimum = value.minimum;
  state.maximum = value.maximum;
  state.disabled = !!value.disabled;
  paint(owner, state);
}
function snapshot(value, oldValue, owner, instance) {
