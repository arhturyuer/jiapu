  if (state.active) {
    state.blocked = true;
    state.suppressTap = true;
  }
  state.active = false;
  report(owner, state, value.id);
}
function point(touch, state) {
  return { id: touch.identifier, x: touch.clientX - state.left, y: touch.clientY - state.top };
}
function pick(touches, id) {
  for (var i = 0; i < touches.length; i++) {
    if (touches[i].identifier === id) return touches[i];
  }
  return null;
}
function rebase(touches, state) {
  var first = pick(touches, state.firstId) || touches[0];
  var second = pick(touches, state.secondId);
  if (!second || second.identifier === first.identifier) {
    second = null;
    for (var i = 0; i < touches.length; i++) {
      if (touches[i].identifier !== first.identifier) { second = touches[i]; break; }
    }
  }
  state.firstId = first.identifier;
  state.secondId = second ? second.identifier : null;
  state.first = point(first, state);
  state.second = second ? point(second, state) : null;
  if (second) state.suppressTap = true;
}
function start(event, owner) {
  var instance = surface(owner);
  if (!instance || !event.touches.length) return;
  var state = instance.getState();
  if (state.disabled || !state.scale || state.blocked) return;
  if (!state.active) {
    state.active = true;
    state.suppressTap = event.touches.length > 1;
    state.origin = point(event.touches[0], state);
    state.firstId = event.touches[0].identifier;
    state.secondId = null;
    report(owner, state, 0);
  }
  rebase(event.touches, state);
}
function move(event, owner) {
  var instance = surface(owner);
  if (!instance) return;
  var state = instance.getState();
  if (!state.active || state.blocked || !event.touches.length) return false;
  var firstTouch = pick(event.touches, state.firstId);
  var secondTouch = state.secondId === null ? null : pick(event.touches, state.secondId);
  if (!firstTouch || (state.second && !secondTouch) || (!state.second && event.touches.length > 1)) {
    rebase(event.touches, state);
    return false;
  }
  var first = point(firstTouch, state);
  if (state.second) {
    var second = point(secondTouch, state);
    var oldX = (state.first.x + state.second.x) / 2;
    var oldY = (state.first.y + state.second.y) / 2;
    var nextX = (first.x + second.x) / 2;
    var nextY = (first.y + second.y) / 2;
    var oldDX = state.first.x - state.second.x;
    var oldDY = state.first.y - state.second.y;
    var dx = first.x - second.x;
    var dy = first.y - second.y;
    var distance = Math.sqrt(oldDX * oldDX + oldDY * oldDY);
    var nextDistance = Math.sqrt(dx * dx + dy * dy);
    // Rebase every frame, including at the limits, so reversal is immediate.
    var nextScale = distance > 0 && nextDistance > 0
