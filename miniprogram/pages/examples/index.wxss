page { overflow-x: hidden; }
.examples-page { max-width: 100%; padding-bottom: 72rpx; overflow-x: hidden; }
.hero { padding: 16rpx 0 32rpx; }
.eyebrow { display: block; color: #245C4A; font-size: var(--reading-font-12, 14px); font-weight: 650; letter-spacing: 2rpx; }
.page-title { margin-top: 12rpx; display: block; font-size: var(--reading-font-22, 22px); font-weight: 650; line-height: 1.35; }
.page-description { margin-top: 14rpx; display: block; color: #65706A; font-size: var(--reading-font-13_5, 14px); line-height: 1.65; }
.tag-scroll { width: 100%; white-space: nowrap; }
.tag-row { padding: 4rpx 0 26rpx; display: inline-flex; gap: 14rpx; }
.tag { flex: none; padding: 14rpx 22rpx; color: #65706A; background: #FFFEFA; border: 2rpx solid #D8DED9; border-radius: 999rpx; font-size: var(--reading-font-13, 14px); }
.tag.active { color: #FFFFFF; background: #245C4A; border-color: #245C4A; }
.example-list { min-width: 0; display: flex; flex-direction: column; gap: 18rpx; }
.example-card { width: 100%; min-width: 0; min-height: 192rpx; padding: 22rpx; display: flex; align-items: center; gap: 20rpx; }
.cover { flex: none; width: 128rpx; height: 128rpx; display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; border-radius: 32rpx; font-size: var(--reading-font-26, 26px); font-weight: 650; }
.card-copy { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; }
.card-title { overflow: hidden; font-size: var(--reading-font-16, 16px); font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.desc-wrap { position: relative; width: 100%; }
.card-desc { display: block; width: 100%; margin-top: 8rpx; color: #65706A; font-size: var(--reading-font-12_5, 14px); line-height: 36rpx; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-all; }
.card-desc.is-collapsed { max-height: 108rpx; overflow: hidden; }
.desc-tail-reserve { visibility: hidden; color: #245C4A; font-weight: 600; white-space: nowrap; }
.card-desc-measure { position: absolute; top: 0; left: 0; visibility: hidden; pointer-events: none; }
.desc-toggle { position: absolute; right: 0; bottom: 0; height: 36rpx; padding-left: 24rpx; color: #245C4A; background: linear-gradient(90deg, rgba(255, 254, 250, 0), #FFFEFA 24rpx); font-size: var(--reading-font-12_5, 14px); font-weight: 600; line-height: 36rpx; }
.desc-wrap.is-expanded .desc-toggle { padding-left: 0; background: #FFFEFA; }
.meta { margin-top: 12rpx; display: flex; gap: 16rpx; color: #65706A; font-size: var(--reading-font-11_5, 14px); }
.card-tags { margin-top: 10rpx; display: flex; gap: 8rpx; flex-wrap: wrap; }
.card-tags text { padding: 4rpx 10rpx; color: #245C4A; background: #E4EFEA; border-radius: 999rpx; font-size: var(--reading-font-10, 14px); }
.arrow { flex: none; color:#65706A; font-size: var(--reading-font-23, 23px); }
.empty-examples { padding: 48rpx 32rpx; display: flex; flex-direction: column; gap: 12rpx; color: #65706A; text-align: center; }
.create-button { width: 100%; margin-top: 32rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .examples-page { padding-bottom: 36px; }
  .hero { padding: 8px 0 16px; }
  .eyebrow { letter-spacing: 1px; }
  .page-title { margin-top: 6px; }
  .page-description { margin-top: 7px; }
  .tag-row { padding: 2px 0 13px; gap: 7px; }
  .tag { padding: 7px 11px; border: 1px solid #D8DED9; border-radius: 499.5px; }
  .example-list { gap: 9px; }
  .example-card { min-height: 96px; padding: 11px; gap: 10px; }
  .cover { width: 64px; height: 64px; border-radius: 16px; }
  .card-desc { margin-top: 4px; line-height: 18px; }
  .card-desc.is-collapsed { max-height: 54px; }
  .desc-toggle { height: 18px; padding-left: 12px; background: linear-gradient(90deg, rgba(255, 254, 250, 0), #FFFEFA 12px); line-height: 18px; }
  .meta { margin-top: 6px; gap: 8px; }
  .card-tags { margin-top: 5px; gap: 4px; }
  .card-tags text { padding: 2px 5px; border-radius: 499.5px; }
  .empty-examples { padding: 24px 16px; gap: 6px; }
  .create-button { margin-top: 16px; }
}
/* large-screen:end */

.card-body{display:flex;width:100%;gap:12px;align-items:flex-start;min-width:0;}
.public-links{display:flex;flex-wrap:wrap;gap:20px;margin:20px 0;color:#245C4A;font-size:var(--reading-font-16,16px);}
