.backup-page { padding-bottom:50rpx; }.backup-hero { padding:30rpx; }.backup-eyebrow,.backup-title,.backup-copy { display:block; }.backup-eyebrow { color:#245C4A; font-size:28rpx; font-weight:650; }.backup-title { margin-top:8rpx; font-size:40rpx; font-weight:700; }.backup-copy { margin-top:14rpx; color:#53655C; font-size:28rpx; line-height:1.65; }.backup-includes { margin-top:26rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.backup-includes view { min-height:126rpx; padding:18rpx 10rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#F2F6F3; border-radius:20rpx; text-align:center; font-size:28rpx; }.include-mark { width:52rpx; height:52rpx; margin-bottom:10rpx; display:flex; align-items:center; justify-content:center; color:#FFFFFF; background:#245C4A; border-radius:16rpx; font-size:28rpx; font-weight:650; }.backup-rules { margin-top:22rpx; display:flex; flex-wrap:wrap; gap:10rpx; }.backup-rules text { padding:8rpx 15rpx; color:#53655C; background:#F5F0E8; border-radius:999rpx; font-size:26rpx; }.permission-tip,.upgrade-card { margin-top:22rpx; padding:26rpx; border-radius:22rpx; font-size:28rpx; line-height:1.55; }.permission-tip { color:#765E3A; background:#FFF4DE; }.upgrade-card { color:#644A19; background:#FFF0CA; }.upgrade-card text { display:block; }.upgrade-card text:first-child { font-size:30rpx; font-weight:650; }.upgrade-card text:last-child { margin-top:8rpx; font-size:28rpx; line-height:1.5; }.create-button { width:100%; min-height:88rpx; margin-top:26rpx; }.task-card { margin-top:24rpx; padding:26rpx; }.task-heading { display:flex; justify-content:space-between; font-size:30rpx; font-weight:650; }.progress-track { height:12rpx; margin-top:18rpx; overflow:hidden; background:#E1E5E1; border-radius:8rpx; }.progress-value { height:100%; background:#245C4A; }.task-note { margin-top:16rpx; display:block; color:#65706A; font-size:28rpx; line-height:1.5; }.task-note.error { color:#9D3535; }.part-row { min-height:116rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; border-top:2rpx solid #EEF0ED; }.part-row:first-of-type { margin-top:18rpx; }.part-row view text { display:block; font-size:28rpx; }.part-row view text:last-child { margin-top:5rpx; color:#65706A; font-size:26rpx; }.part-row button { width:210rpx; min-height:88rpx; font-size:28rpx; }.privacy-note { margin-top:24rpx; padding:14rpx 24rpx 24rpx; }.privacy-heading { min-height:88rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.privacy-heading view { min-width:0; }.privacy-title,.privacy-summary { display:block; }.privacy-title { font-size:30rpx; font-weight:650; }.privacy-summary { margin-top:5rpx; color:#65706A; font-size:28rpx; }.privacy-arrow { flex:none; color:#245C4A; font-size:28rpx; }.privacy-detail { margin-top:8rpx; padding-top:18rpx; display:block; color:#53655C; border-top:2rpx solid #EEF0ED; font-size:28rpx; line-height:1.7; }.text-link { min-height:88rpx; margin-top:20rpx; display:flex; align-items:center; justify-content:center; color:#245C4A; background:transparent; font-size:28rpx; text-decoration:underline; }
