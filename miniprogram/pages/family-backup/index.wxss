.backup-page { padding-bottom:50rpx; }.backup-hero { padding:30rpx; }.backup-title,.backup-copy,.backup-rule { display:block; }.backup-title { font-size:36rpx; font-weight:700; }.backup-copy { margin-top:18rpx; line-height:1.7; }.backup-rule { margin-top:20rpx; color:#65706A; font-size:23rpx; line-height:1.6; }.permission-tip,.upgrade-card { margin-top:22rpx; padding:26rpx; border-radius:22rpx; }.permission-tip { color:#765E3A; background:#FFF4DE; }.upgrade-card { color:#644A19; background:#FFF0CA; }.upgrade-card text { display:block; }.upgrade-card text:first-child { font-size:30rpx; font-weight:650; }.upgrade-card text:last-child { margin-top:8rpx; font-size:24rpx; line-height:1.5; }.create-button { width:100%; margin-top:26rpx; }.task-card { margin-top:24rpx; padding:26rpx; }.task-heading { display:flex; justify-content:space-between; font-size:29rpx; font-weight:650; }.progress-track { height:12rpx; margin-top:18rpx; overflow:hidden; background:#E1E5E1; border-radius:8rpx; }.progress-value { height:100%; background:#245C4A; }.task-note { margin-top:16rpx; display:block; color:#65706A; font-size:23rpx; line-height:1.5; }.task-note.error { color:#9D3535; }.part-row { min-height:108rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; border-top:2rpx solid #EEF0ED; }.part-row:first-of-type { margin-top:18rpx; }.part-row view text { display:block; }.part-row view text:last-child { margin-top:5rpx; color:#65706A; font-size:22rpx; }.part-row button { width:190rpx; min-height:68rpx; font-size:23rpx; }.security-note { margin-top:28rpx; padding:24rpx; color:#65706A; background:#ECEFEB; border-radius:20rpx; }.security-note text { display:block; }.security-note text:first-child { color:#313936; font-weight:650; }.security-note text:last-child { margin-top:8rpx; font-size:23rpx; line-height:1.6; }.text-link { margin-top:24rpx; color:#245C4A; background:transparent; font-size:26rpx; text-decoration:underline; }
