.feedback-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.feedback-hero { padding: 38rpx 32rpx; display: flex; flex-direction: column; }
.feedback-eyebrow { color: #245C4A; font-size: var(--reading-font-14, 16px); font-weight: 600; }
.feedback-title { margin-top: 12rpx; font-size: var(--reading-font-21, 21px); font-weight: 650; line-height: 1.35; }
.feedback-desc { margin-top: 18rpx; color: #65706A; line-height: 1.7; }
.qr-card { margin-top: 30rpx; padding: 32rpx; display: flex; flex-direction: column; align-items: center; }
.qr-title { font-size: var(--reading-font-16, 16px); font-weight: 650; }
.qr-image { width: 440rpx; height: 440rpx; margin-top: 28rpx; border-radius: 16rpx; background: #fff; }
