.report-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.target-card { padding: 30rpx; display: flex; flex-direction: column; }
.target-label { color: #65706A; font-size: var(--reading-font-12_5, 14px); }
.target-name { margin-top: 8rpx; font-size: var(--reading-font-19, 19px); font-weight: 650; }
.target-help { margin-top: 12rpx; color: #65706A; font-size: var(--reading-font-12_5, 14px); line-height: 1.6; }
.report-section { margin-top: 36rpx; }
.report-section > .section-title { margin-bottom: 16rpx; display: block; }
.reason-list { padding: 0 24rpx; }
.reason-row { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EEF0ED; }
.reason-row:last-child { border-bottom: none; }
.reason-row.selected { color: #245C4A; font-weight: 650; }
.reason-check { color: #245C4A; }
.detail-input { width: 100%; height: 240rpx; padding: 24rpx; background: #FFFEFA; border: 2rpx solid #D8DED9; border-radius: 24rpx; line-height: 1.6; }
.submit-report { width: 100%; margin-top: 36rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .report-page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
  .target-card { padding: 15px; }
  .target-name { margin-top: 4px; }
  .target-help { margin-top: 6px; }
  .report-section { margin-top: 18px; }
  .report-section > .section-title { margin-bottom: 8px; }
  .reason-list { padding: 0 12px; }
  .reason-row { min-height: 48px; border-bottom: 1px solid #EEF0ED; }
  .detail-input { height: 120px; padding: 12px; border: 1px solid #D8DED9; border-radius: 12px; }
  .submit-report { margin-top: 18px; }
}
/* large-screen:end */
