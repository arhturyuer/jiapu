.intro-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.intro-hero { position: relative; overflow: hidden; min-height: 360rpx; padding: 40rpx 36rpx 150rpx; }
.intro-eyebrow { display: block; color: #245C4A; font-size: var(--reading-font-13, 14px); font-weight: 650; letter-spacing: 2rpx; }
.intro-title { display: block; margin-top: 18rpx; color: #202824; font-size: var(--reading-font-24, 24px); font-weight: 650; line-height: 1.35; }
.intro-title-second { margin-top: 0; }
.intro-copy { display: block; max-width: 560rpx; margin-top: 20rpx; color: #65706A; font-size: var(--reading-font-14_5, 16px); line-height: 1.6; }
.intro-art { position: absolute; right: 24rpx; bottom: 18rpx; width: 240rpx; height: 142rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.art-node { z-index: 1; width: 92rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #245C4A; background: #E4EFEA; font-size: var(--reading-font-12_5, 14px); font-weight: 600; }
.art-node-top { position: absolute; top: 0; left: 74rpx; width: 92rpx; height: 72rpx; color: #FFFFFF; background: #245C4A; }
.art-link { position: absolute; top: 65rpx; left: 45rpx; width: 150rpx; height: 52rpx; border: 3rpx solid #9DB59E; border-bottom: 0; border-radius: 28rpx 28rpx 0 0; }
.intro-section { margin-top: 40rpx; }
.section-title { display: block; margin-bottom: 18rpx; font-size: var(--reading-font-17, 17px); font-weight: 650; }
.intro-steps { padding: 8rpx 32rpx; }
.intro-step { display: flex; gap: 22rpx; padding: 28rpx 0; border-bottom: 2rpx solid #EEF0ED; }
.intro-step:last-child { border-bottom: 0; }
.step-number { flex: none; width: 50rpx; height: 50rpx; border-radius: 50%; color: #FFFFFF; background: #245C4A; font-size: var(--reading-font-12_5, 14px); font-weight: 600; line-height: 50rpx; text-align: center; }
.intro-step > view { min-width: 0; flex: 1; }
.step-title { display: block; color: #202824; font-size: var(--reading-font-15_5, 16px); font-weight: 600; }
.step-copy { display: block; margin-top: 8rpx; color: #65706A; font-size: var(--reading-font-13_5, 14px); line-height: 1.55; }
.intro-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 32rpx; }
.intro-button { width: 100%; min-height: 88rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .intro-page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
  .intro-hero { min-height: 180px; padding: 20px 18px 75px; }
  .intro-eyebrow { letter-spacing: 1px; }
  .intro-title { margin-top: 9px; }
  .intro-copy { max-width: 280px; margin-top: 10px; }
  .intro-art { right: 12px; bottom: 9px; width: 120px; height: 71px; }
  .art-node { width: 46px; height: 36px; border-radius: 12px; }
  .art-node-top { left: 37px; width: 46px; height: 36px; }
  .art-link { top: 32.5px; left: 22.5px; width: 75px; height: 26px; border: 1.5px solid #9DB59E; border-radius: 14px 14px 0 0; }
  .intro-section { margin-top: 20px; }
  .section-title { margin-bottom: 9px; }
  .intro-steps { padding: 4px 16px; }
  .intro-step { gap: 11px; padding: 14px 0; border-bottom: 1px solid #EEF0ED; }
  .step-number { width: 25px; height: 25px; line-height: 25px; }
  .step-copy { margin-top: 4px; }
  .intro-actions { gap: 9px; margin-top: 16px; }
  .intro-button { min-height: 44px; }
}
/* large-screen:end */
