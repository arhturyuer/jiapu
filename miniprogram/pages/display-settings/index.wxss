.settings-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.settings-intro { padding: 30rpx; }
.settings-family, .settings-copy { display: block; }
.settings-family { font-size: var(--reading-font-18, 18px); font-weight: 650; }
.settings-copy { margin-top: 10rpx; color: #65706A; font-size: var(--reading-font-13, 14px); line-height: 1.6; }
.section-block { margin-top: 38rpx; }
.layout-picker { padding: 18rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.layout-option { min-height: 180rpx; padding: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #65706A; background: #F3F2EC; border: 3rpx solid transparent; border-radius: 22rpx; }
.layout-option.selected { color: #245C4A; background: #E4EFEA; border-color: #245C4A; }
.layout-title { font-size: var(--reading-font-14, 16px); font-weight: 650; }
.layout-example { margin-top: 16rpx; font-size: var(--reading-font-15, 16px); font-weight: 600; letter-spacing: 2rpx; }
.layout-example-vertical { line-height: 1.1; text-align: center; }
.layout-example-vertical text { display: block; }
.setting-list { padding: 0 26rpx; }
.setting-row { min-height: 126rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 2rpx solid #EEF0ED; }
.setting-row:last-child { border-bottom: none; }
.setting-copy { min-width: 0; flex: 1; }
.setting-title, .setting-desc { display: block; }
.setting-title { font-size: var(--reading-font-15, 16px); font-weight: 600; }
.setting-desc { margin-top: 7rpx; color: #65706A; font-size: var(--reading-font-12, 14px); line-height: 1.45; }
.save-state { margin-top: 28rpx; display: block; color: #65706A; font-size: var(--reading-font-12, 14px); text-align: center; }
.empty-action { width: 320rpx; }
.avatar-style-setting { padding: 24rpx 0; }
.avatar-style-picker { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; margin-top: 18rpx; }
.avatar-style-option { box-sizing: border-box; width: 100%; min-width: 0; min-height: 96rpx; margin: 0; padding: 12rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; line-height: 1.4; font-size: var(--reading-font-15, 16px); font-weight: 600; color: #65706A; background: #F3F2EC; border: 3rpx solid transparent; border-radius: 16rpx; }
.avatar-style-icon { flex: none; width: 52rpx; height: 52rpx; border-radius: 18rpx; }
.avatar-style-option.selected { color: #245C4A; background: #E4EFEA; border-color: #245C4A; }
.reading-elder .avatar-style-option { min-height: 60px; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .settings-page { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
  .settings-intro { padding: 15px; }
  .settings-copy { margin-top: 5px; }
  .section-block { margin-top: 19px; }
  .layout-picker { padding: 9px; gap: 8px; }
  .layout-option { min-height: 90px; padding: 10px; border: 1.5px solid transparent; border-radius: 11px; }
  .layout-example { margin-top: 8px; letter-spacing: 1px; }
  .setting-list { padding: 0 13px; }
  .setting-row { min-height: 63px; gap: 12px; border-bottom: 1px solid #EEF0ED; }
  .setting-desc { margin-top: 3.5px; }
  .save-state { margin-top: 14px; }
  .empty-action { width: 160px; }
  .avatar-style-setting { padding: 12px 0; }
  .avatar-style-picker { gap: 8px; margin-top: 9px; }
  .avatar-style-option { min-height: 48px; padding: 6px; gap: 6px; border: 1.5px solid transparent; border-radius: 8px; }
  .avatar-style-icon { width: 26px; height: 26px; border-radius: 9px; }
}
/* large-screen:end */
