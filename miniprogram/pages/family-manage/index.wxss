.manage-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.archive-card { padding: 34rpx; display: flex; flex-direction: column; gap: 18rpx; }
.archive-title { color: #8A5A16; font-size: var(--reading-font-18, 18px); font-weight: 650; }
.archive-desc { color: #765E3A; line-height: 1.6; }
.manage-section { margin-top: 34rpx; }
.form-card { padding: 30rpx; }
.field-label { margin-bottom: 12rpx; display: block; font-weight: 650; }
.second-label { margin-top: 28rpx; }
.field-input, .field-textarea { width: 100%; padding: 0 22rpx; background: #F3F2EC; border: 2rpx solid #D8DED9; border-radius: 20rpx; }
.field-input { height: 92rpx; }
.field-textarea { height: 180rpx; padding-top: 20rpx; }
.save-button { width: 100%; margin-top: 28rpx; }
.member-list, .invite-list, .danger-zone { padding: 0 24rpx; }
.member-row, .invite-row, .danger-row { min-height: 116rpx; display: flex; align-items: center; border-bottom: 2rpx solid #EEF0ED; }
.invite-row { gap: 16rpx; }
.member-row:last-child, .invite-row:last-child, .danger-row:last-child { border-bottom: none; }
.member-avatar { width: 72rpx; height: 72rpx; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; border-radius: 22rpx; font-weight: 650; }
.member-copy, .invite-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.member-name, .invite-name { font-weight: 650; }
.invite-name, .invite-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-role, .invite-meta, .danger-desc { margin-top: 5rpx; color: #65706A; font-size: var(--reading-font-12, 14px); }
.member-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.member-action { color: #245C4A; font-size: var(--reading-font-12_5, 14px); font-weight: 600; }
.empty-invite { padding: 36rpx; color: #65706A; text-align: center; }
.revoke-button { width: 112rpx; height: 62rpx; padding: 0; display: inline-flex; flex: none; align-items: center; justify-content: center; color: #B43D3D; background: #FBEDEC; border: 2rpx solid rgba(180, 61, 61, 0.16); border-radius: 18rpx; font-size: var(--reading-font-12_5, 14px); font-weight: 600; line-height: 1; }
.revoke-button:active { background: #F5DAD8; }
.danger-row { justify-content: space-between; }
.danger-title { display: block; color: #B43D3D; font-weight: 650; }
.danger-arrow { color: #B43D3D; font-size: var(--reading-font-24, 24px); }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .manage-page { padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
  .archive-card { padding: 17px; gap: 9px; }
  .manage-section { margin-top: 17px; }
  .form-card { padding: 15px; }
  .field-label { margin-bottom: 6px; }
  .second-label { margin-top: 14px; }
  .field-input, .field-textarea { padding: 0 11px; border: 1px solid #D8DED9; border-radius: 10px; }
  .field-input { height: 46px; }
  .field-textarea { height: 90px; padding-top: 10px; }
  .save-button { margin-top: 14px; }
  .member-list, .invite-list, .danger-zone { padding: 0 12px; }
  .member-row, .invite-row, .danger-row { min-height: 58px; border-bottom: 1px solid #EEF0ED; }
  .invite-row { gap: 8px; }
  .member-avatar { width: 36px; height: 36px; margin-right: 9px; border-radius: 11px; }
  .member-role, .invite-meta, .danger-desc { margin-top: 2.5px; }
  .member-actions { gap: 4px; }
  .empty-invite { padding: 18px; }
  .revoke-button { width: 56px; height: 31px; border: 1px solid rgba(180, 61, 61, 0.16); border-radius: 9px; }
}
/* large-screen:end */

.manage-description { display: block; margin: 8px 0 12px; color: #65706A; font-size: var(--reading-font-13, 14px); line-height: 1.6; }
.manage-profile-entry, .invite-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 44px; padding: 12px 0; background: transparent; text-align: left; font-size: inherit; }
.manage-profile-entry .setting-title, .manage-profile-entry .member-role { display: block; }
.member-row { flex-wrap: wrap; gap: 8px; padding: 12px 0; }
.member-copy { flex-basis: 140px; overflow-wrap: anywhere; }
.member-action { min-height: 44px; width: auto; padding: 8px 0; background: transparent; font-size: var(--reading-font-13, 14px); }
.reading-elder .member-action, .reading-elder .manage-profile-entry, .reading-elder .invite-heading { min-height: 60px; }
