
<view class="reading-root {{elderMode ? 'reading-elder' : ''}} {{readingLarge ? 'reading-large' : ''}}" style="{{readingStyle}}{{readingDockStyle}}">
<view class="loading-panel" wx:if="{{loading}}"><view aria-hidden="true" class="loading-dot"></view><text>正在读取家庭权限...</text></view>
<view class="page-shell" wx:elif="{{error}}"><view class="empty-panel"><view class="empty-mark">!</view><text class="empty-title">无法打开</text><text class="empty-description">{{error}}</text><button class="secondary-button" bindtap="loadPage">重新加载</button></view></view>
<view class="manage-page page-shell" wx:else>
  <view class="archive-card surface-card" wx:if="{{family.status === 'archived'}}">
    <text class="archive-title">这份家谱在回收站中</text>
    <text class="archive-desc">恢复后，原家庭成员和资料可以继续使用。</text>
    <button class="primary-button" bindtap="restoreFamily">恢复家谱</button>
    <button class="secondary-button" bindtap="leaveFamily">退出这份归档家谱</button>
  </view>

  <block wx:if="{{family.status === 'active'}}">
    <view class="manage-section"><view class="member-list surface-card"><button class="manage-profile-entry" bindtap="openFamilyProfile"><view><text class="setting-title">家谱资料</text><text class="member-role">家族概况、字辈、历史与家训</text></view><text aria-hidden="true">›</text></button></view></view>

    <view class="manage-section" id="collaborator-section">
      <view class="section-heading"><text class="section-title">已加入的家人</text><text class="muted-text">{{collaborators.length}} 人</text></view>
      <text class="manage-description">这里是已加入这份家谱的使用者，与谱中记录的人物不同。</text>
      <view class="member-list surface-card">
        <view class="member-row" wx:for="{{collaborators}}" wx:key="_id">
          <view class="member-avatar">{{item.initial}}</view>
          <view class="member-copy"><text class="member-name">{{item.displayName}}</text><text class="member-role">{{item.roleText}}</text><text class="member-role">{{item.roleDescription}}</text></view>
          <button class="member-action" wx:if="{{isAdmin}}" data-id="{{item._id}}" bindtap="managePermissions">管理权限</button>
        </view>
      </view>
    </view>

    <view class="manage-section" wx:if="{{isAdmin}}">
      <button class="invite-heading" bindtap="toggleInvites"><text class="section-title">邀请管理</text><text class="muted-text">{{invitesExpanded ? '收起 ⌃' : '展开查看 ›'}}</text></button>
      <block wx:if="{{invitesExpanded}}">
        <view class="empty-invite surface-card" wx:if="{{invitesLoading && !invitesLoaded}}">正在读取邀请...</view>
        <view class="empty-invite surface-card" wx:elif="{{invitesLoaded && !invitations.length}}">还没有生成过邀请</view>
        <view class="invite-list surface-card" wx:if="{{invitations.length}}">
          <view class="invite-row" wx:for="{{invitations}}" wx:key="_id"><view class="invite-copy"><text class="invite-name">{{item.inviteTitle}}</text><text class="invite-meta">{{item.statusText}} · {{item.usageText}}</text></view><button class="revoke-button" wx:if="{{item.displayStatus === 'active'}}" data-id="{{item._id}}" bindtap="revokeInvite">撤销</button></view>
          <button class="secondary-button" wx:if="{{hasMoreInvites && !invitesError}}" loading="{{loadingMoreInvites}}" disabled="{{invitesLoading}}" bindtap="loadMoreInvites">加载更多邀请</button>
        </view>
        <view class="empty-invite surface-card" wx:if="{{invitesError}}"><text>{{invitesError}}</text><button class="secondary-button" bindtap="retryInvites">重新加载邀请</button></view>
      </block>
    </view>

    <view class="manage-section">
      <view class="section-heading"><text class="section-title">数据与退出</text></view>
      <view class="danger-zone surface-card">
        <view data-reading-control="true" aria-role="button" class="danger-row" bindtap="copyFamily"><view><text class="danger-title">复制家谱</text><text class="danger-desc">复制成一份由你管理的新家谱</text></view><text class="danger-arrow">›</text></view>
        <view data-reading-control="true" aria-role="button" class="danger-row" bindtap="reportFamily"><view><text class="danger-title">举报家谱描述</text><text class="danger-desc">向运营人员反馈不当内容</text></view><text class="danger-arrow">›</text></view>
        <view data-reading-control="true" aria-role="button" class="danger-row" wx:if="{{isAdmin}}" bindtap="archiveFamily"><view><text class="danger-title">移入回收站</text><text class="danger-desc">{{archiving ? '正在移入回收站，请稍候' : '30 天内可以恢复'}}</text></view><text class="danger-arrow">›</text></view>
        <view data-reading-control="true" aria-role="button" class="danger-row" bindtap="leaveFamily"><view><text class="danger-title">退出家谱</text><text class="danger-desc">退出后需要重新接受邀请</text></view><text class="danger-arrow">›</text></view>
      </view>
    </view>
  </block>
</view>
</view>
