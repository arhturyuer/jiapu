<view class="loading-panel" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在加载会员方案…</text></view>
<view class="page-shell" wx:elif="{{pageError}}">
  <view class="empty-panel"><text class="empty-title">暂时无法加载会员页</text><text class="empty-description">{{pageError}}</text><button class="primary-button empty-action" bindtap="loadPage">重新加载</button><button class="purchase-contact" open-type="contact">联系微信客服</button></view>
</view>
<view class="page-shell" wx:elif="{{!families.length}}">
  <view class="empty-panel"><text class="empty-title">{{selectionError || '还没有可购买会员的家谱'}}</text><text class="empty-description">创建或加入家谱后，全体家人可共享会员权益</text><button class="primary-button empty-action" bindtap="createFamily">创建家谱</button><button class="secondary-button empty-action" bindtap="loadPage">重新加载家谱</button></view>
</view>
<view class="membership-page page-shell" style="{{dockHeight ? 'padding-bottom: calc(' + dockHeight + (isWide ? 'px + 12px)' : 'px + 24rpx)') : ''}}" wx:else>
  <view class="purchase-family surface-card">
    <picker range="{{families}}" range-key="name" value="{{familyIndex < 0 ? 0 : familyIndex}}" disabled="{{paying || redeeming}}" bindchange="changeFamily"><view class="family-picker"><text>{{family ? family.name : '请选择家谱'}}</text><text>{{paying || redeeming ? '处理中' : '切换 ›'}}</text></view></picker>
    <text class="current-status">{{selectionError || (statusReady ? membershipText : statusError ? '会员权益读取失败' : family ? '正在读取会员权益…' : '请选择要购买的家谱')}}</text>
    <text class="scope-copy">这份家谱全体家人共享</text>
  </view>
  <view class="purchase-error surface-card" wx:if="{{selectionError}}"><text>{{selectionError}}</text><button class="secondary-button" wx:for="{{families}}" wx:key="_id" data-index="{{index}}" bindtap="changeFamily">选择 {{item.name}}</button></view>
  <view class="purchase-error surface-card" wx:if="{{statusError}}"><text>{{statusError}}</text><button class="secondary-button" bindtap="retryFamily" disabled="{{paying}}">重试读取权益</button></view>
  <view class="benefit-heading"><text class="value-title">一份家谱，全家共享</text><text class="value-subtitle">记录家族故事，留存珍贵记忆</text></view>
  <view class="benefit-grid">
    <view><text class="benefit-icon">谱</text><text class="benefit-title">家谱 PDF</text><text class="benefit-description">导出家谱树与家谱书，打印留存</text></view>
    <view><text class="benefit-icon">净</text><text class="benefit-title">全家免广告</text><text class="benefit-description">查看家谱更专注</text></view>
    <view><text class="benefit-icon">迹</text><text class="benefit-title">完整修改记录</text><text class="benefit-description">家谱变化有迹可循</text></view>
    <view><text class="benefit-icon">藏</text><text class="benefit-title">家庭资料备份</text><text class="benefit-description">管理员导出资料与照片</text></view>
  </view>
  <view class="section-heading"><text class="section-title">选择会员期限</text><text class="muted-text">不自动续费</text></view>
  <view class="product-card {{selectedProductId === item.productId ? 'selected' : ''}}" wx:for="{{products}}" wx:key="productId" data-id="{{item.productId}}" bindtap="selectProduct">
    <view class="product-copy"><text class="product-name">{{item.displayName}}</text><text class="recommend" wx:if="{{item.recommended}}">推荐</text></view><text class="price">{{item.priceText}}</text><text class="product-check">{{selectedProductId === item.productId ? '✓' : ''}}</text>
  </view>
  <text class="term-note" wx:if="{{products.length}}">{{termText}}</text>
  <view class="purchase-error" wx:else><text>暂无可购买的会员方案</text><button class="secondary-button" bindtap="loadPage">重新加载方案</button></view>
  <view class="payment-state {{paymentState}}" wx:if="{{paymentMessage}}">
    <text class="state-message">{{paymentMessage}}</text>
    <view class="state-actions" wx:if="{{showPaymentRefresh && !paying}}"><button class="text-action" loading="{{refreshingOrderId}}" disabled="{{refreshingOrderId}}" bindtap="refreshPayment">刷新支付状态</button><button class="text-action" open-type="contact">联系客服</button></view>
  </view>
  <view class="records surface-card">
    <view class="records-toggle" bindtap="toggleRecords"><text class="section-title">会员记录</text><text class="records-indicator">{{recordsExpanded ? '收起 ∧' : '查看 ›'}}</text></view>
    <view wx:if="{{recordsExpanded}}">
      <view class="order-loading" wx:if="{{loadingOrders}}">正在加载会员记录…</view>
      <view class="purchase-error" wx:elif="{{ordersError}}"><text>{{ordersError}}</text><button class="secondary-button" bindtap="retryOrders">重试加载记录</button></view>
      <view class="order-list" wx:elif="{{orders.length}}">
        <view class="order-row" wx:for="{{orders}}" wx:key="recordId">
          <view class="order-copy"><text class="order-name">{{item.productName}}</text><text class="order-meta">{{item.typeText}} · {{item.timeText}}</text><button wx:if="{{item.recordType === 'payment'}}" class="order-copy-id" data-id="{{item.orderId}}" bindtap="copyOrder">复制订单号</button><text wx:else class="order-meta">{{item.maskedCode}}</text></view>
          <view class="order-side"><text class="order-price">{{item.priceText}}</text><text class="order-status {{item.statusClass}}">{{item.statusText}}</text></view>
        </view>
        <button class="secondary-button order-more" wx:if="{{hasMoreOrders}}" loading="{{loadingMoreOrders}}" disabled="{{loadingMoreOrders}}" bindtap="loadMoreOrders">加载更多</button>
      </view>
      <view class="order-empty" wx:elif="{{ordersReady && family}}">暂无购买或兑换记录</view>
    </view>
  </view>
  <view class="help-row">
    <button class="text-action redeem-entry" disabled="{{paying || redeeming || !family}}" bindtap="openRedeem">兑换码</button>
    <button class="purchase-contact" open-type="contact">联系客服</button>
  </view>
  <view wx:if="{{redeemOpen}}" class="redeem-overlay" catchtap="closeRedeem">
    <view class="redeem-dialog surface-card" catchtap="stopRedeemTap">
      <text class="section-title">兑换家庭会员</text><text class="redeem-family">{{family.name}}</text>
      <text class="redeem-note">仅免费或会员已到期的家谱可兑换。兑换成功后，全体家人共享权益，兑换码不可再次使用。</text>
      <input class="redeem-input" value="{{redeemCode}}" maxlength="100" disabled="{{redeeming}}" placeholder="输入或粘贴兑换码" bindinput="inputRedeem" />
      <text wx:if="{{redeemError}}" class="redeem-error">{{redeemError}}</text>
      <view class="agreement"><text>兑换表示同意</text><text class="rule-link" bindtap="openRules">《家庭会员与退款说明》</text></view>
      <button class="primary-button" disabled="{{redeeming || !statusReady}}" loading="{{redeeming}}" bindtap="submitRedeem">{{redeeming ? '正在兑换' : '确认兑换'}}</button>
      <button class="text-action" disabled="{{redeeming}}" bindtap="closeRedeem">取消</button>
    </view>
  </view>
  <text class="term-note" wx:if="{{isDesktop && paymentMode !== 'mock'}}">电脑端暂不发起购买，请在手机微信打开当前家谱开通。兑换码和权益查询可在此使用。</text>
  <view class="purchase-dock">
    <view class="dock-inner"><view class="agreement"><text>开通会员表示同意</text><text class="rule-link" bindtap="openRules">《家庭会员与退款说明》</text></view><button class="primary-button pay-button" loading="{{paying}}" disabled="{{!canBuy}}" bindtap="startPayment">{{payLabel}}</button></view>
  </view>
</view>
