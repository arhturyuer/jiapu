  .benefit-icon { width:26px; height:26px; margin-bottom:8px; border-radius:8px; }
  .benefit-description { margin-top:4px; }
  .product-card { min-height:44px; gap:9px; padding:10px 12px; margin-top:6px; border:1.5px solid #E6E9E4; border-radius:12px; }
  .product-copy { gap:6px; }
  .recommend { padding:2px 6px; border-radius:5px; }
  .product-check { width:18px; height:18px; border:1px solid #ABB9AF; }
  .term-note { margin:8px 2px 0; }
  .payment-state { margin-top:12px; padding:10px 12px; border:1px solid #F0DBB5; border-radius:12px; }
  .state-actions { gap:8px; }
  .text-action,.purchase-contact,.order-copy-id { min-height:44px; padding:8px 4px; }
  .records { margin-top:16px; }
  .records-toggle { min-height:44px; padding:6px 12px; gap:8px; }
  .order-row { padding:10px 12px; gap:9px; border-top:1px solid #EEF0ED; }
  .order-meta { margin-top:3px; }
  .order-status { margin-top:4px; }
  .order-more { margin:6px 12px 12px; min-height:44px; }
