.membership-page { padding-bottom:calc(52rpx + env(safe-area-inset-bottom)); }.purchase-family { padding:30rpx; background:linear-gradient(145deg,#1F5646,#397961); color:#fff; }.eyebrow,.scope-copy,.current-status { display:block; }.eyebrow { font-size:24rpx; opacity:.75; }.family-picker { margin-top:10rpx; display:flex; justify-content:space-between; font-size:42rpx; font-weight:700; }.family-picker text:last-child { font-size:26rpx; font-weight:500; }.scope-copy { margin-top:16rpx; font-size:24rpx; opacity:.82; }.current-status { margin-top:22rpx; font-size:28rpx; font-weight:650; }.benefit-grid { margin:24rpx 0 40rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.benefit-grid view { padding:22rpx 12rpx; background:#FFFEFA; border-radius:20rpx; text-align:center; }.benefit-grid text { display:block; }.benefit-grid text:first-child { color:#245C4A; font-weight:650; }.benefit-grid text:last-child { margin-top:8rpx; color:#65706A; font-size:21rpx; line-height:1.4; }.product-card { margin-top:16rpx; padding:26rpx; display:flex; justify-content:space-between; align-items:center; gap:20rpx; background:#FFFEFA; border:3rpx solid transparent; border-radius:24rpx; }.product-card.selected { border-color:#245C4A; background:#F1F7F3; }.product-name,.product-desc { display:block; }.product-name { font-size:30rpx; font-weight:650; }.product-desc { margin-top:7rpx; color:#65706A; font-size:22rpx; }.price { flex:none; text-align:right; }.price text { display:block; color:#245C4A; font-size:34rpx; font-weight:700; }.price text:last-child:not(:first-child) { margin-top:4rpx; color:#8A5A16; font-size:20rpx; }.agreement { margin-top:32rpx; display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; color:#65706A; font-size:24rpx; }.check { width:34rpx; height:34rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #9AA39E; border-radius:8rpx; }.check.checked { color:#fff; background:#245C4A; border-color:#245C4A; }.rule-link { color:#245C4A; }.pay-button { width:100%; margin-top:24rpx; }.payment-state { margin-top:20rpx; padding:20rpx; color:#765E3A; background:#FFF4DE; border-radius:18rpx; font-size:25rpx; line-height:1.5; }.payment-state.success { color:#245C4A; background:#E7F2ED; }.payment-state.failed { color:#9D3535; background:#FBEDEC; }.order-heading { margin-top:42rpx; }.order-list { overflow:hidden; }.order-row { min-height:116rpx; padding:20rpx 24rpx; display:flex; align-items:center; gap:18rpx; border-bottom:2rpx solid #EEF0ED; }.order-row:last-child { border-bottom:none; }.order-copy { min-width:0; flex:1; }.order-name,.order-meta,.order-price,.order-status { display:block; }.order-name { overflow:hidden; font-size:28rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.order-meta { margin-top:6rpx; color:#65706A; font-size:22rpx; }.order-side { display:flex; flex:none; flex-direction:column; align-items:flex-end; }.order-price { color:#245C4A; font-size:27rpx; font-weight:650; }.order-status { margin-top:4rpx; color:#765E3A; font-size:22rpx; }.order-status.fulfilled { color:#245C4A; }.order-status.refunded,.order-status.failed,.order-status.closed { color:#9D3535; }.order-refresh { min-width:132rpx; height:52rpx; min-height:52rpx; margin:8rpx 0 0; padding:0 14rpx; color:#245C4A; background:#EEF6F1; border:0; border-radius:999rpx; font-size:21rpx; line-height:52rpx; }.order-more { margin:18rpx 24rpx 22rpx; }.order-empty,.order-loading { padding:28rpx 24rpx; color:#7B8580; font-size:24rpx; }.order-loading { text-align:center; }.payment-footnote { margin-top:24rpx; display:block; color:#7B8580; font-size:22rpx; line-height:1.65; }
