.membership-page { padding-bottom:calc(52rpx + env(safe-area-inset-bottom)); }.purchase-family { padding:30rpx; background:linear-gradient(145deg,#1F5646,#397961); color:#fff; }.eyebrow,.scope-copy,.current-status { display:block; }.eyebrow { font-size:28rpx; opacity:.78; }.family-picker { min-height:88rpx; margin-top:4rpx; display:flex; align-items:center; justify-content:space-between; font-size:42rpx; font-weight:700; }.family-picker text:last-child { font-size:28rpx; font-weight:500; }.scope-copy { margin-top:12rpx; font-size:28rpx; line-height:1.55; opacity:.86; }.current-status { margin-top:20rpx; font-size:30rpx; font-weight:650; }.benefit-grid { margin:24rpx 0 40rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }.benefit-grid view { padding:24rpx 12rpx; background:#FFFEFA; border:2rpx solid #E6E9E4; border-radius:24rpx; text-align:center; }.benefit-grid text { display:block; }.benefit-grid text:first-child { color:#245C4A; font-size:30rpx; font-weight:650; }.benefit-grid text:last-child { margin-top:8rpx; color:#65706A; font-size:28rpx; line-height:1.5; }.product-card { min-height:88rpx; margin-top:16rpx; padding:26rpx; display:flex; justify-content:space-between; align-items:center; gap:20rpx; background:#FFFEFA; border:3rpx solid transparent; border-radius:26rpx; }.product-card.selected { border-color:#245C4A; background:#F1F7F3; }.product-name,.product-desc { display:block; }.product-name { font-size:30rpx; font-weight:650; }.product-desc { margin-top:7rpx; color:#65706A; font-size:28rpx; line-height:1.5; }.price { flex:none; text-align:right; }.price text { display:block; color:#245C4A; font-size:34rpx; font-weight:700; }.price text:last-child:not(:first-child) { margin-top:4rpx; color:#8A5A16; font-size:26rpx; }.agreement { min-height:88rpx; margin-top:20rpx; display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; color:#65706A; font-size:28rpx; }.check { width:38rpx; height:38rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #9AA39E; border-radius:8rpx; }.check.checked { color:#fff; background:#245C4A; border-color:#245C4A; }.rule-link { color:#245C4A; }.pay-button { width:100%; min-height:88rpx; margin-top:16rpx; }.payment-state { margin-top:20rpx; padding:26rpx; display:flex; gap:20rpx; color:#765E3A; background:#FFF8E9; border:2rpx solid #F0DBB5; border-radius:26rpx; }.payment-state.success { color:#245C4A; background:#EDF7F1; border-color:#CBE3D6; }.payment-state.failed,.payment-state.cancelled { color:#9D3535; background:#FFF2F0; border-color:#ECCBC7; }.state-mark { width:54rpx; height:54rpx; display:flex; flex:none; align-items:center; justify-content:center; color:#fff; background:#B78635; border-radius:50%; font-size:28rpx; font-weight:700; }.success .state-mark { background:#2F765D; }.failed .state-mark,.cancelled .state-mark { background:#B24B45; }.state-copy,.state-title,.state-message,.state-next { display:block; }.state-copy { min-width:0; flex:1; }.state-title { font-size:30rpx; font-weight:700; }.state-message { margin-top:6rpx; font-size:28rpx; line-height:1.55; }.state-next { margin-top:12rpx; font-size:28rpx; font-weight:600; }.order-heading { margin-top:42rpx; }.order-list { overflow:hidden; }.order-row { min-height:116rpx; padding:20rpx 24rpx; display:flex; align-items:center; gap:18rpx; border-bottom:2rpx solid #EEF0ED; }.order-row:last-child { border-bottom:none; }.order-copy { min-width:0; flex:1; }.order-name,.order-meta,.order-price,.order-status { display:block; }.order-name { overflow:hidden; font-size:28rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.order-meta { margin-top:6rpx; color:#65706A; font-size:28rpx; }.order-side { display:flex; flex:none; flex-direction:column; align-items:flex-end; }.order-price { color:#245C4A; font-size:28rpx; font-weight:650; }.order-status { margin-top:4rpx; color:#765E3A; font-size:28rpx; }.order-status.fulfilled { color:#245C4A; }.order-status.refunded,.order-status.failed,.order-status.closed { color:#9D3535; }.order-refresh { min-width:164rpx; min-height:88rpx; margin:8rpx 0 0; padding:0 18rpx; color:#245C4A; background:#EEF6F1; border:0; border-radius:999rpx; font-size:28rpx; line-height:88rpx; }.order-more { min-height:88rpx; margin:18rpx 24rpx 22rpx; }.order-empty,.order-loading { padding:28rpx 24rpx; color:#7B8580; font-size:28rpx; }.order-loading { text-align:center; }.payment-note { margin-top:24rpx; padding:24rpx; display:flex; gap:16rpx; align-items:flex-start; color:#65706A; font-size:28rpx; line-height:1.65; }.payment-note-mark { width:40rpx; height:40rpx; display:flex; flex:none; align-items:center; justify-content:center; color:#245C4A; background:#E1EFE7; border-radius:50%; font-size:28rpx; font-weight:700; }
