  .purchase-error button { margin-top:8px; min-height:44px; padding:8px; }
  .help-row { gap:12px; margin-top:8px; }
  .purchase-dock { padding:4px 16px calc(10px + env(safe-area-inset-bottom)); border-top:1px solid #E6E9E4; box-shadow:0 -4px 14px rgba(36,92,74,.04); }
  .dock-inner { max-width:450px; }
  .agreement { column-gap:2px; }
  .rule-link { min-height:44px; }
  .purchase-dock .dock-inner .pay-button { min-height:44px; padding:10px; }
  .redeem-overlay { padding:16px; }
  .redeem-dialog { max-width:370px; padding:16px; }
  .redeem-family { margin-top:8px; }
  .redeem-note { margin-top:6px; }
  .redeem-input { min-height:44px; margin-top:12px; padding:0 10px; border:1px solid #DCE6DB; border-radius:8px; }
