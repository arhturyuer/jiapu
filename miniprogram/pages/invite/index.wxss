.invite-page { min-height: 100vh; padding-top: 48rpx; }
.brand-line { display: flex; align-items: center; justify-content: center; margin-bottom: 40rpx; }
.brand-mark { width: 64rpx; height: 64rpx; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #245C4A; border-radius: 18rpx; font-weight: 600; }
.brand-name { font-size: var(--reading-font-20, 20px); font-weight: 600; }
.invite-card { padding: 50rpx 36rpx; text-align: center; }
.eyebrow { color: #65706A; font-size: var(--reading-font-14, 16px); }
.family-name { margin-top: 18rpx; display: block; font-size: var(--reading-font-26, 26px); font-weight: 600; }
.family-stats { margin-top: 30rpx; display: flex; align-items: center; justify-content: center; color: #245C4A; font-weight: 600; }
.dot { margin: 0 14rpx; }
.view-note { margin-top: 30rpx; color: #245C4A; font-size: var(--reading-font-14, 16px); }
.privacy-note { margin: 24rpx 0 0; display: block; color: #65706A; text-align: center; font-size: var(--reading-font-13, 14px); }
.accept-button { width: 100%; margin-top: 32rpx; }
.invalid-panel { min-height: 760rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.invite-mark { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; border-radius: 36rpx; font-size: var(--reading-font-26, 26px); font-weight: 600; }
.invite-mark.muted { color: #65706A; background: #E8E9E5; }
.invite-title { margin-top: 30rpx; font-size: var(--reading-font-20, 20px); font-weight: 600; }
.invite-description { margin-top: 14rpx; color: #65706A; }
.home-button { width: 320rpx; margin-top: 40rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .invite-page { padding-top: 24px; }
  .brand-line { margin-bottom: 20px; }
  .brand-mark { width: 32px; height: 32px; margin-right: 8px; border-radius: 9px; }
  .invite-card { padding: 25px 18px; }
  .family-name { margin-top: 9px; }
  .family-stats { margin-top: 15px; }
  .dot { margin: 0 7px; }
  .view-note { margin-top: 15px; }
  .privacy-note { margin: 12px 0 0; }
  .accept-button { margin-top: 16px; }
  .invalid-panel { min-height: 380px; }
  .invite-mark { width: 60px; height: 60px; border-radius: 18px; }
  .invite-title { margin-top: 15px; }
  .invite-description { margin-top: 7px; }
  .home-button { width: 160px; margin-top: 20px; }
}
/* large-screen:end */
