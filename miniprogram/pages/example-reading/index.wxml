<view class="reading-root {{elderMode ? 'reading-elder' : ''}} {{readingLarge ? 'reading-large' : ''}}" style="{{readingStyle}}"><page-navigation title="官方示例说明" home page-gutter /><view class="page-shell guide-page"><view wx:if="{{loading}}" class="loading-panel">正在读取示例…</view><view wx:elif="{{error}}" class="empty-panel"><text>{{error}}</text><button class="secondary-button" bindtap="load">重新加载</button></view><view wx:elif="{{example}}"><text class="guide-title">{{example.title}}</text><text class="guide-summary">官方虚构示例，仅用于体验。{{example.personCount}} 位人物，{{example.relationCount}} 条关系。</text><text class="guide-copy" space="nbsp">{{example.description || '通过人物和关系，体验从不同视角理解一家人的家谱。'}}</text><navigator class="surface-card guide-link" url="/pages/example/index?slug={{slug}}">交互浏览这张示例家谱</navigator><text class="guide-heading">人物与亲属关系</text><navigator class="surface-card guide-link" wx:for="{{example.persons}}" wx:key="_id" url="/pages/example-person-detail/index?slug={{slug}}&id={{item._id}}"><text class="guide-heading">{{item.name}}</text><text class="guide-summary">{{item.bio || '查看这个人物的资料和直接亲属关系'}}</text></navigator><button class="primary-button guide-create" bindtap="createFamily">创建我的家谱</button></view><view class="guide-nav"><navigator url="/pages/examples/index">全部示例</navigator><navigator url="/pages/guides/index">修谱指南</navigator><navigator url="/pages/share-intro/index">认识有谱</navigator></view></view></view>
