.activity-page { padding-bottom:50rpx; }.filter-card { padding:24rpx; }.filter-row { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }.filter-row input,.date-row picker { min-height:72rpx; padding:0 16rpx; display:flex; align-items:center; background:#F3F2EC; border-radius:14rpx; font-size:24rpx; }.date-row { margin-top:14rpx; display:flex; align-items:center; gap:12rpx; color:#65706A; }.date-row picker { flex:1; }.filter-actions { margin-top:18rpx; display:flex; justify-content:flex-end; gap:12rpx; }.filter-actions button { width:150rpx; min-height:68rpx; font-size:25rpx; }.upgrade-tip { margin:20rpx 0; padding:24rpx; display:flex; align-items:center; justify-content:space-between; color:#674B17; background:#FFF1D1; border-radius:20rpx; }.upgrade-tip text { display:block; }.upgrade-tip view text:first-child { font-weight:650; }.upgrade-tip view text:last-child { margin-top:5rpx; font-size:22rpx; }.history-list { margin-top:20rpx; padding:8rpx 24rpx; }.history-row { min-height:108rpx; padding:22rpx 0; display:flex; border-bottom:2rpx solid #EEF0ED; }.history-row:last-child { border-bottom:none; }.history-dot { width:14rpx; height:14rpx; margin:13rpx 18rpx 0 0; flex:none; background:#245C4A; border-radius:50%; }.history-summary,.history-meta { display:block; }.history-summary { line-height:1.5; }.history-meta { margin-top:7rpx; color:#65706A; font-size:22rpx; }.more-button { width:100%; margin-top:24rpx; }
