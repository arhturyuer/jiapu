.activity-page { padding-bottom:50rpx; }.activity-intro { margin-bottom:24rpx; }.activity-title,.activity-copy { display:block; }.activity-title { font-size:40rpx; font-weight:700; }.activity-copy { margin-top:8rpx; color:#65706A; font-size:28rpx; }.filter-card { padding:28rpx; }.filter-title { display:block; font-size:32rpx; font-weight:650; }.filter-field { margin-top:24rpx; }.filter-label { margin-bottom:10rpx; display:block; color:#53655C; font-size:28rpx; font-weight:600; }.filter-picker,.filter-input,.date-picker { min-height:88rpx; padding:0 22rpx; display:flex; align-items:center; background:#F3F2EC; border:2rpx solid #D8DED9; border-radius:18rpx; font-size:28rpx; }.filter-picker { justify-content:space-between; }.filter-picker text:last-child { color:#86A99A; font-size:38rpx; }.date-row { display:flex; align-items:center; gap:12rpx; }.date-row picker { min-width:0; flex:1; }.date-picker { justify-content:center; color:#53655C; }.date-divider { color:#65706A; font-size:28rpx; }.active-filters { margin-top:20rpx; display:flex; flex-wrap:wrap; gap:10rpx; }.active-filters text { min-height:48rpx; padding:7rpx 16rpx; display:flex; align-items:center; color:#245C4A; background:#E4EFEA; border-radius:999rpx; font-size:26rpx; }.filter-actions { margin-top:26rpx; display:grid; grid-template-columns:1fr 2fr; gap:14rpx; }.filter-actions button { width:100%; min-height:88rpx; font-size:28rpx; }.upgrade-tip { margin:20rpx 0; padding:24rpx; display:flex; align-items:center; justify-content:space-between; color:#674B17; background:#FFF1D1; border-radius:20rpx; }.upgrade-tip text { display:block; }.upgrade-tip view text:first-child { font-size:30rpx; font-weight:650; }.upgrade-tip view text:last-child { margin-top:5rpx; font-size:28rpx; }.history-list { margin-top:20rpx; padding:8rpx 24rpx; }.history-row { min-height:116rpx; padding:24rpx 0; display:flex; border-bottom:2rpx solid #EEF0ED; }.history-row:last-child { border-bottom:none; }.history-dot { width:16rpx; height:16rpx; margin:14rpx 20rpx 0 0; flex:none; background:#245C4A; border:5rpx solid #E4EFEA; border-radius:50%; }.history-copy { min-width:0; flex:1; }.history-summary,.history-meta { display:block; }.history-summary { font-size:30rpx; line-height:1.55; }.history-meta { margin-top:8rpx; color:#65706A; font-size:26rpx; }.more-button { width:100%; min-height:88rpx; margin-top:24rpx; }
