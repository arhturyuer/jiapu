<view class="activity-page page-shell">
  <view class="activity-intro"><text class="activity-title">家谱变更记录</text><text class="activity-copy">按家人、变化类型和日期查找记录。</text></view>
  <view class="filter-card surface-card">
    <text class="filter-title">筛选记录</text>
    <view class="filter-field"><text class="filter-label">变化类型</text><picker range="{{actionOptions}}" range-key="label" value="{{actionIndex}}" bindchange="changeAction"><view class="filter-picker"><text>{{actionLabel}}</text><text>›</text></view></picker></view>
    <view class="filter-field"><text class="filter-label">操作人</text><input class="filter-input" placeholder="输入家人名字" value="{{actorName}}" bindinput="inputActor"/></view>
    <view class="filter-field"><text class="filter-label">日期范围</text><view class="date-row"><picker mode="date" value="{{from}}" bindchange="changeFrom"><view class="date-picker">{{from || '开始日期'}}</view></picker><text class="date-divider">至</text><picker mode="date" value="{{toDate}}" bindchange="changeTo"><view class="date-picker">{{toDate || '结束日期'}}</view></picker></view></view>
    <view class="active-filters" wx:if="{{action || actorName || from || toDate}}"><text wx:if="{{action}}">{{actionLabel}}</text><text wx:if="{{actorName}}">{{actorName}}</text><text wx:if="{{from || toDate}}">{{from || '不限'}} 至 {{toDate || '今天'}}</text></view>
    <view class="filter-actions"><button class="secondary-button" bindtap="clearFilters">重置</button><button class="primary-button" bindtap="applyFilters">查看记录</button></view>
  </view>
  <view class="upgrade-tip" wx:if="{{membershipRequired}}" bindtap="openMembership"><view><text>免费家庭显示最近 20 条</text><text>升级后可查看自功能上线以来的完整历史并分页筛选。</text></view><text>升级 ›</text></view>
  <view class="loading-panel" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在读取变更历史…</text></view>
  <view class="history-list surface-card" wx:elif="{{items.length}}"><view class="history-row" wx:for="{{items}}" wx:key="_id"><view class="history-dot"></view><view class="history-copy"><text class="history-summary">{{item.actorName || '家庭成员'}} {{item.summaryText}}</text><text class="history-meta">{{item.timeText}}</text></view></view></view>
  <view class="empty-panel" wx:else><text class="empty-title">没有匹配的变更记录</text><text class="empty-description">修改家谱后，记录会出现在这里。</text></view>
  <button class="secondary-button more-button" wx:if="{{hasMore}}" loading="{{loadingMore}}" bindtap="loadMore">加载更早记录</button>
</view>
