.copy-page { padding-bottom: 64rpx; }
.copy-card { padding: 30rpx; margin-bottom: 24rpx; }
.card-title { display: block; color: #245C4A; font-size: 32rpx; font-weight: 600; }
.copy-note { display: block; color: #68776F; font-size: 26rpx; line-height: 1.65; margin-top: 16rpx; overflow-wrap: break-word; }
.field-label { display: block; margin-top: 30rpx; margin-bottom: 16rpx; color: #344A40; font-size: 28rpx; }
.field-input {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0 22rpx;
  background: #F7F4EC;
  border: 2rpx solid #D8DED9;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.task-card button { margin-top: 24rpx; }
.missing-title { display: block; margin-top: 30rpx; color: #9A6537; font-size: 28rpx; }
.missing-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid #E7E8DF; padding-top: 20rpx; margin-top: 20rpx; }
.missing-row > view { min-width: 0; flex: 1; }
.missing-row button { flex-shrink: 0; margin: 0; padding: 12rpx 18rpx; font-size: 26rpx; min-height: 88rpx; }
.person-name { display: block; font-size: 28rpx; color: #344A40; }
.start-button { margin-top: 30rpx; }
