.copy-page { padding-bottom: 64rpx; }
.copy-card { padding: 30rpx; margin-bottom: 24rpx; }
.card-title { display: block; color: #245C4A; font-size: var(--reading-font-16, 16px); font-weight: 600; }
.copy-note { display: block; color: #68776F; font-size: var(--reading-font-13, 14px); line-height: 1.65; margin-top: 16rpx; overflow-wrap: break-word; }
.field-label { display: block; margin-top: 30rpx; margin-bottom: 16rpx; color: #344A40; font-size: var(--reading-font-14, 16px); }
.field-input {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0 22rpx;
  background: #F7F4EC;
  border: 2rpx solid #D8DED9;
  border-radius: 16rpx;
  font-size: var(--reading-font-15, 16px);
}
.task-card button { margin-top: 24rpx; }
.missing-title { display: block; margin-top: 30rpx; color: #9A6537; font-size: var(--reading-font-14, 16px); }
.missing-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid #E7E8DF; padding-top: 20rpx; margin-top: 20rpx; }
.missing-row > view { min-width: 0; flex: 1; }
.missing-row button { flex-shrink: 0; margin: 0; padding: 12rpx 18rpx; font-size: var(--reading-font-13, 14px); min-height: 88rpx; }
.person-name { display: block; font-size: var(--reading-font-14, 16px); color: #344A40; }
.start-button { margin-top: 30rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .copy-page { padding-bottom: 32px; }
  .copy-card { padding: 15px; margin-bottom: 12px; }
  .copy-note { margin-top: 8px; }
  .field-label { margin-top: 15px; margin-bottom: 8px; }
  .field-input { height: 46px; padding: 0 11px; border: 1px solid #D8DED9; border-radius: 8px; }
  .task-card button { margin-top: 12px; }
  .missing-title { margin-top: 15px; }
  .missing-row { gap: 8px; border-top: 0.5px solid #E7E8DF; padding-top: 10px; margin-top: 10px; }
  .missing-row button { padding: 6px 9px; min-height: 44px; }
  .start-button { margin-top: 15px; }
}
/* large-screen:end */
