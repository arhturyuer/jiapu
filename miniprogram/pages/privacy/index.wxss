.privacy-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.privacy-hero { padding: 38rpx 32rpx; display: flex; flex-direction: column; }
.privacy-eyebrow { color: #245C4A; font-size: var(--reading-font-14, 16px); font-weight: 600; }
.privacy-title { margin-top: 12rpx; font-size: var(--reading-font-21, 21px); font-weight: 650; line-height: 1.35; }
.privacy-desc { margin-top: 18rpx; color: #65706A; line-height: 1.7; }
.privacy-version { margin-top: 22rpx; color: #65706A; font-size: var(--reading-font-13_5, 14px); }
.pending-card { margin-top: 24rpx; padding: 28rpx; display: flex; flex-direction: column; gap: 16rpx; border-color: #E7B66E; }
.pending-title { color: #8A5A16; font-weight: 650; }
.pending-desc { color: #765E3A; font-size: var(--reading-font-14, 16px); line-height: 1.6; }
.policy-section { margin-top: 38rpx; }
.policy-section > .section-title { margin-bottom: 16rpx; display: block; }
.policy-card { padding: 0 28rpx; }
.policy-row { padding: 26rpx 0; display: flex; flex-direction: column; gap: 8rpx; border-bottom: 2rpx solid #EEF0ED; }
.policy-row:last-child { border-bottom: none; }
.policy-label { font-weight: 650; }
.policy-copy { color: #65706A; font-size: var(--reading-font-14, 16px); line-height: 1.65; }
.action-list { padding: 0 24rpx; }
.action-row { width: 100%; min-height: 116rpx; padding: 20rpx 0; display: flex; align-items: center; justify-content: space-between; background: transparent; border-bottom: 2rpx solid #EEF0ED; text-align: left; }
.action-row-active { background: #F4F8F5; }
.action-row:last-child { border-bottom: none; }
.contact-row { position: relative; }
.contact-trigger { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; left: 0; margin: 0; padding: 0; background: transparent; border-radius: 0; }
.contact-trigger::after { border: none; }
.action-title, .action-desc { display: block; }
.action-title { font-size: var(--reading-font-16, 16px); font-weight: 650; }
.action-desc { margin-top: 6rpx; color: #65706A; font-size: var(--reading-font-14, 16px); line-height: 1.45; }
.action-arrow { color:#65706A; font-size: var(--reading-font-24, 24px); }
.status-text { color: #8A641F; font-size: var(--reading-font-14, 16px); }
.operator-note { margin-top: 38rpx; padding: 28rpx; display: flex; flex-direction: column; gap: 10rpx; color: #65706A; font-size: var(--reading-font-14, 16px); line-height: 1.6; }
.deletion-button { width: 100%; margin-top: 30rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .privacy-page { padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
  .privacy-hero { padding: 19px 16px; }
  .privacy-title { margin-top: 6px; }
  .privacy-desc { margin-top: 9px; }
  .privacy-version { margin-top: 11px; }
  .pending-card { margin-top: 12px; padding: 14px; gap: 8px; }
  .policy-section { margin-top: 19px; }
  .policy-section > .section-title { margin-bottom: 8px; }
  .policy-card { padding: 0 14px; }
  .policy-row { padding: 13px 0; gap: 4px; border-bottom: 1px solid #EEF0ED; }
  .action-list { padding: 0 12px; }
  .action-row { min-height: 58px; padding: 10px 0; border-bottom: 1px solid #EEF0ED; }
  .action-desc { margin-top: 3px; }
  .operator-note { margin-top: 19px; padding: 14px; gap: 5px; }
  .deletion-button { margin-top: 15px; }
}
/* large-screen:end */
