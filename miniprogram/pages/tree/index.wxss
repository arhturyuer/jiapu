  max-width: 260px;
  margin-bottom: 3px;
  font-size: 22px;
}

.tree-page.is-landscape .person-rank-basis,
.tree-page.is-landscape .action-desc,
.tree-page.is-landscape .child-order-help {
  font-size: 12px;
}

.tree-page.is-landscape .action-grid {
  gap: 8px;
}

.tree-page.is-landscape .action-cell {
  min-height: 64px;
  padding: 10px 12px;
  border-radius: 12px;
}

.tree-page.is-landscape .action-title {
  margin-bottom: 3px;
  font-size: 14px;
}

.tree-page.is-landscape .family-option,
.tree-page.is-landscape .perspective-option {
  min-height: 52px;
  padding: 8px 10px;
}

.tree-page.is-landscape .family-option-role,
.tree-page.is-landscape .family-option-check {
  margin-top: 2px;
  font-size: 12px;
}

.tree-page.is-landscape .perspective-sheet,
.tree-page.is-landscape .child-order-sheet {
