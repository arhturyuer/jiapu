@import "../../styles/graph-clean-screen.wxss";
.share-card-canvas { position: fixed; left: -1600rpx; top: -1600rpx; width: 750px; height: 600px; opacity: 0; pointer-events: none; }
.tree-page {
  height: calc(100vh - 0px);
  overflow: hidden;
  background: #F7F4EC;
}

.tree-top-ad {
  position: absolute;
  top: 128rpx;
  right: 24rpx;
  left: 24rpx;
  z-index: 24;
}

.tree-top-ad-template {
  display: block;
  width: 100%;
}

.tree-top-ad-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #F7F4EC;
}

.tree-top-ad-close,
.tree-top-ad-membership {
  min-height: 64rpx;
  margin: 0;
  display: flex;
  align-items: center;
  background: transparent;
  border-radius: 12rpx;
}

.tree-top-ad-close {
  flex: none;
  width: 64rpx;
  min-width: 64rpx;
  padding: 0;
  margin-left: 0;
  margin-right: auto;
  justify-content: flex-start;
}

.tree-top-ad-membership {
  width: auto;
  margin-left: auto;
  padding: 8rpx 4rpx;
  justify-content: flex-end;
  color: #245C4A;
  font-size: var(--reading-font-12, 14px);
  line-height: 1.5;
}

.tree-top-ad-close::after,
.tree-top-ad-membership::after {
  border: none;
}

.empty-action {
  width: 360rpx;
}

.empty-guide-actions {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.invite-help {
  width: 520rpx;
  margin-top: 12rpx;
  color: #65706A;
  font-size: var(--reading-font-12_5, 14px);
  line-height: 1.5;
  text-decoration: underline;
  text-align: center;
}

.tree-toolbar {
  height: 112rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F7F4EC;
  border-bottom: 2rpx solid rgba(36, 92, 74, 0.08);
}

.mode-switch {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 6rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #E9EAE4;
  border-radius: 20rpx;
}

.mode-item {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #65706A;
  border-radius: 16rpx;
  font-size: var(--reading-font-13, 14px);
  white-space: nowrap;
}

.mode-item.active {
  color: #245C4A;
  background: #FFFEFA;
  font-weight: 600;
}

.toolbar-share {
  flex: none;
  width: 88rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #245C4A;
  background: #FFFEFA;
  border: 2rpx solid #D8DED9;
  border-radius: 20rpx;
  font-size: var(--reading-font-14, 16px);
  font-weight: 600;
}

.tree-share-reminder { position:absolute; top:128rpx; right:24rpx; left:24rpx; z-index:24; padding:24rpx; display:flex; align-items:center; gap:20rpx; background:rgba(241,247,243,.98); border:2rpx solid #B9D2C5; border-radius:22rpx; box-shadow:0 10rpx 28rpx rgba(36,92,74,.12); }.tree-share-reminder-copy { min-width:0; flex:1; display:flex; flex-direction:column; }.tree-share-reminder-title { font-size: var(--reading-font-14_5, 16px); font-weight:650; }.tree-share-reminder-desc { margin-top:5rpx; color:#53655C; font-size: var(--reading-font-11, 14px); line-height:1.45; }.tree-share-reminder-actions { flex:none; display:flex; flex-direction:column; align-items:flex-end; gap:6rpx; }.tree-share-reminder-invite { width:120rpx; min-width:120rpx; height:60rpx; margin:0; padding:0 8rpx; color:#FFFFFF; background:#245C4A; border-radius:16rpx; font-size: var(--reading-font-11_5, 14px); line-height:60rpx; white-space:nowrap; }.tree-share-reminder-dismiss { min-height:38rpx; padding:0; color:#65706A; background:transparent; font-size: var(--reading-font-10_5, 14px); line-height:38rpx; }

.graph-viewport {
  position: relative;
  width: 100%;
  height: calc(100vh - 112rpx);
  overflow: hidden;
  background-color: #F7F4EC;
  background-image: radial-gradient(rgba(36, 92, 74, 0.09) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
}

.graph-controls {
  position: fixed;
  right: 24rpx;
  bottom: calc(206rpx + env(safe-area-inset-bottom));
  z-index: 22;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.graph-control {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #245C4A;
  background: rgba(255, 254, 250, 0.96);
  border: 2rpx solid #D8DED9;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(36, 59, 49, 0.09);
  font-size: var(--reading-font-17, 17px);
  font-weight: 600;
}

.graph-control-text {
  font-size: var(--reading-font-11, 14px);
  font-weight: 500;
}

.orientation-control.is-disabled {
  opacity: 0.55;
}

.graph-control.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.graph-movable {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
  display: block;
  will-change: transform;
}

.graph-canvas {
  position: relative;
  min-width: calc(750rpx * var(--graph-content-scale, 1));
  min-height: calc(900rpx * var(--graph-content-scale, 1));
  background: transparent;
}

.relation-line {
  position: absolute;
  z-index: 1;
  height: calc(4rpx * var(--graph-content-scale, 1));
  overflow: hidden;
  pointer-events: none;
  transform-origin: left center;
  background: #A6B7AE;
  border-radius: calc(999rpx * var(--graph-content-scale, 1));
}

.relation-spouse {
  height: calc(5rpx * var(--graph-content-scale, 1));
  background: #829D91;
}

.relation-trunk,
.relation-drop {
  height: calc(4rpx * var(--graph-content-scale, 1));
  background: #A6B7AE;
}

.relation-rail {
  height: calc(3rpx * var(--graph-content-scale, 1));
  background: #BEC9C3;
}

.relation-flow {
  z-index: 2;
  height: calc(6rpx * var(--graph-content-scale, 1));
  background: #6F9E89;
}

.line-crossing {
  position: absolute;
  z-index: 3;
  width: calc(14rpx * var(--graph-content-scale, 1));
  height: calc(14rpx * var(--graph-content-scale, 1));
  pointer-events: none;
  border-radius: 50%;
  background: #F7F4EC;
}

.line-crossing::after {
  content: '';
  position: absolute;
  top: 0;
  left: calc(5rpx * var(--graph-content-scale, 1));
  width: calc(4rpx * var(--graph-content-scale, 1));
  height: calc(14rpx * var(--graph-content-scale, 1));
  border-radius: calc(4rpx * var(--graph-content-scale, 1));
  background: #A6B7AE;
}

.line-crossing.is-spouse::after { background: #829D91; }

.flow-runner {
  width: 100%;
  height: 100%;
  opacity: 0;
  background: linear-gradient(90deg, #245C4A 0%, #3E8069 72%, #D7E9E1 100%);
  border-radius: calc(999rpx * var(--graph-content-scale, 1));
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform, opacity;
  animation-duration: 2.4s;
  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  animation-iteration-count: infinite;
}

.flow-runner.flow-step-0 { animation-name: family-flow-pulse-0; }
.flow-runner.flow-step-1 { animation-name: family-flow-pulse-1; }
.flow-runner.flow-step-2 { animation-name: family-flow-pulse-2; }
.flow-runner.flow-step-3 { animation-name: family-flow-pulse-3; }

@keyframes family-flow-pulse-0 {
  0% { opacity: 0; transform: scaleX(0); }
  2% { opacity: 1; transform: scaleX(0); }
  20% { opacity: 1; transform: scaleX(1); }
  24%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-1 {
  0%, 25% { opacity: 0; transform: scaleX(0); }
  27% { opacity: 1; transform: scaleX(0); }
  45% { opacity: 1; transform: scaleX(1); }
  49%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-2 {
  0%, 50% { opacity: 0; transform: scaleX(0); }
  52% { opacity: 1; transform: scaleX(0); }
  70% { opacity: 1; transform: scaleX(1); }
  74%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-3 {
  0%, 75% { opacity: 0; transform: scaleX(0); }
  77% { opacity: 1; transform: scaleX(0); }
  95% { opacity: 1; transform: scaleX(1); }
  99%, 100% { opacity: 0; transform: scaleX(1); }
}

.family-junction {
  position: absolute;
  z-index: 3;
  width: calc(14rpx * var(--graph-content-scale, 1));
  height: calc(14rpx * var(--graph-content-scale, 1));
  pointer-events: none;
  background: #829D91;
  border: calc(3rpx * var(--graph-content-scale, 1)) solid #F7F4EC;
  border-radius: 50%;
}

.family-junction.is-active {
  background: #245C4A;
  border-color: #D7E9E1;
  transform: scale(1.12);
}

.person-node {
