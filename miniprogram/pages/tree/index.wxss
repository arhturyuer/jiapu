}

.graph-control {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #245C4A;
  background: rgba(255, 254, 250, 0.96);
  border: 2rpx solid #D8DED9;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(36, 59, 49, 0.09);
  font-size: 34rpx;
  font-weight: 600;
}

.graph-control-text {
  font-size: 22rpx;
  font-weight: 500;
}

.orientation-control.is-disabled {
  opacity: 0.55;
}

.graph-control.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.graph-movable {
  display: block;
  will-change: transform;
}

.graph-canvas {
  position: relative;
  min-width: 750rpx;
  min-height: 900rpx;
  background: transparent;
}

.relation-line {
  position: absolute;
  z-index: 1;
  height: 4rpx;
  overflow: hidden;
  pointer-events: none;
  transform-origin: left center;
  background: #A6B7AE;
  border-radius: 999rpx;
}

.relation-spouse {
  height: 5rpx;
  background: #829D91;
}

.relation-trunk,
.relation-drop {
  height: 4rpx;
  background: #A6B7AE;
}

.relation-rail {
  height: 3rpx;
  background: #BEC9C3;
}

.relation-flow {
  z-index: 2;
  height: 6rpx;
  background: #6F9E89;
}

.line-crossing {
  position: absolute;
  z-index: 3;
  width: 14rpx;
  height: 14rpx;
  pointer-events: none;
  border-radius: 50%;
  background: #F7F4EC;
}

.line-crossing::after {
  content: '';
  position: absolute;
  top: 0;
  left: 5rpx;
  width: 4rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: #A6B7AE;
}

.line-crossing.is-spouse::after { background: #829D91; }

.flow-runner {
  width: 100%;
  height: 100%;
  opacity: 0;
  background: linear-gradient(90deg, #245C4A 0%, #3E8069 72%, #D7E9E1 100%);
  border-radius: 999rpx;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform, opacity;
  animation-duration: 2.4s;
  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  animation-iteration-count: infinite;
}

.flow-runner.flow-step-0 { animation-name: family-flow-pulse-0; }
.flow-runner.flow-step-1 { animation-name: family-flow-pulse-1; }
.flow-runner.flow-step-2 { animation-name: family-flow-pulse-2; }
.flow-runner.flow-step-3 { animation-name: family-flow-pulse-3; }

@keyframes family-flow-pulse-0 {
  0% { opacity: 0; transform: scaleX(0); }
  2% { opacity: 1; transform: scaleX(0); }
  20% { opacity: 1; transform: scaleX(1); }
  24%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-1 {
  0%, 25% { opacity: 0; transform: scaleX(0); }
  27% { opacity: 1; transform: scaleX(0); }
  45% { opacity: 1; transform: scaleX(1); }
  49%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-2 {
  0%, 50% { opacity: 0; transform: scaleX(0); }
  52% { opacity: 1; transform: scaleX(0); }
  70% { opacity: 1; transform: scaleX(1); }
  74%, 100% { opacity: 0; transform: scaleX(1); }
}

@keyframes family-flow-pulse-3 {
  0%, 75% { opacity: 0; transform: scaleX(0); }
  77% { opacity: 1; transform: scaleX(0); }
  95% { opacity: 1; transform: scaleX(1); }
  99%, 100% { opacity: 0; transform: scaleX(1); }
}

