  .perspective-list { height:calc(72vh - 95px); margin-top:8px; }
  .perspective-option { min-height:52px; padding:10px; border-bottom:1px solid #EEF0ED; }
  .small-avatar { width:32px; height:32px; margin-right:10px; border-radius:10px; }
  .person-sheet-name-row { gap:6px; }
  .person-sheet-name { max-width:195px; }
  .perspective-name { margin-right:8px; }
  .person-rank-basis { margin-bottom:2.5px; }
  .person-sheet-life-status { min-width:19px; height:17px; padding:0 4.5px; border-radius:8.5px; }
  .person-sheet-content { padding-bottom:12px; }
  .member-relation-section { margin-top:12px; }
  .member-relation-title { margin-bottom:7px; }
  .member-relation-grid { gap:6px; }
  .member-relation-option { min-height:38px; border:1px solid #C5D8CF; border-radius:9px; }
}
