.share-card-canvas { position:fixed; left:-1600rpx; top:-1600rpx; width:750px; height:600px; opacity:0; pointer-events:none; }.example-page { height:100vh; overflow:hidden; background:#F7F4EC; }.empty-action { width:360rpx; }
.example-header { height:196rpx; padding:20rpx 24rpx 16rpx; box-sizing:border-box; background:#F7F4EC; border-bottom:2rpx solid rgba(36,92,74,.08); }.example-identity { min-width:0; display:flex; flex-direction:column; }.example-title { overflow:hidden; font-size:32rpx; font-weight:600; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }.example-subtitle { margin-top:4rpx; color:#65706A; font-size:22rpx; line-height:1.35; }.example-actions { height:72rpx; margin-top:16rpx; display:flex; gap:16rpx; }.mode-switch { flex:1; min-width:0; height:72rpx; padding:6rpx; display:flex; background:#E9EAE4; border-radius:20rpx; box-sizing:border-box; }.mode-item { flex:1; min-width:0; padding:0 10rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; color:#65706A; border-radius:16rpx; font-size:26rpx; text-overflow:ellipsis; white-space:nowrap; }.mode-item.active { color:#245C4A; background:#FFFEFA; font-weight:600; }.toolbar-share { width:128rpx; height:72rpx; padding:0; flex:0 0 128rpx; display:flex; align-items:center; justify-content:center; color:#245C4A; background:#FFFEFA; border:2rpx solid #D8DED9; border-radius:20rpx; font-size:26rpx; font-weight:600; }
.graph-viewport { width:100%; height:calc(100vh - 196rpx - 120rpx); overflow:hidden; background-color:#F7F4EC; background-image:radial-gradient(rgba(36,92,74,.09) 1rpx,transparent 1rpx); background-size:32rpx 32rpx; }.graph-movable { display:block; will-change:transform; }.graph-canvas { position:relative; min-width:750rpx; min-height:900rpx; background:transparent; }.graph-controls { position:fixed; right:24rpx; bottom:calc(206rpx + env(safe-area-inset-bottom)); z-index:22; display:flex; flex-direction:column; gap:10rpx; }.graph-control { width:72rpx; height:64rpx; display:flex; align-items:center; justify-content:center; color:#245C4A; background:rgba(255,254,250,.96); border:2rpx solid #D8DED9; border-radius:18rpx; box-shadow:0 6rpx 18rpx rgba(36,59,49,.09); font-size:34rpx; font-weight:600; }.graph-control-text { font-size:22rpx; font-weight:500; }
.orientation-control.is-disabled { opacity:.55; }
.relation-line { position:absolute; z-index:1; height:4rpx; overflow:hidden; pointer-events:none; transform-origin:left center; background:#A6B7AE; border-radius:999rpx; }.relation-spouse { height:5rpx; background:#829D91; }.relation-rail { height:3rpx; background:#BEC9C3; }.relation-flow { z-index:2; height:6rpx; background:#6F9E89; }.flow-runner { width:100%; height:100%; opacity:0; background:linear-gradient(90deg,#245C4A 0%,#3E8069 72%,#D7E9E1 100%); border-radius:999rpx; transform:scaleX(0); transform-origin:left center; animation-duration:2.4s; animation-timing-function:cubic-bezier(.4,0,.2,1); animation-iteration-count:infinite; }.flow-runner.flow-step-0 { animation-name:example-flow-0; }.flow-runner.flow-step-1 { animation-name:example-flow-1; }.flow-runner.flow-step-2 { animation-name:example-flow-2; }.flow-runner.flow-step-3 { animation-name:example-flow-3; }
@keyframes example-flow-0 { 0% { opacity:0; transform:scaleX(0); } 2% { opacity:1; } 20% { opacity:1; transform:scaleX(1); } 24%,100% { opacity:0; transform:scaleX(1); } } @keyframes example-flow-1 { 0%,25% { opacity:0; transform:scaleX(0); } 27% { opacity:1; } 45% { opacity:1; transform:scaleX(1); } 49%,100% { opacity:0; transform:scaleX(1); } } @keyframes example-flow-2 { 0%,50% { opacity:0; transform:scaleX(0); } 52% { opacity:1; } 70% { opacity:1; transform:scaleX(1); } 74%,100% { opacity:0; transform:scaleX(1); } } @keyframes example-flow-3 { 0%,75% { opacity:0; transform:scaleX(0); } 77% { opacity:1; } 95% { opacity:1; transform:scaleX(1); } 99%,100% { opacity:0; transform:scaleX(1); } }
.family-junction { position:absolute; z-index:3; width:14rpx; height:14rpx; pointer-events:none; background:#829D91; border:3rpx solid #F7F4EC; border-radius:50%; }.family-junction.is-active { background:#245C4A; border-color:#D7E9E1; transform:scale(1.12); }.person-node { position:absolute; z-index:4; width:168rpx; height:164rpx; min-height:164rpx; padding:14rpx 12rpx 12rpx; display:flex; flex-direction:column; align-items:center; background:#FFFEFA; border:2rpx solid #D8DED9; border-radius:24rpx; }.person-node.is-viewpoint { border:5rpx solid #245C4A; box-shadow:0 0 0 8rpx rgba(36,92,74,.12); }.person-node.is-selected { border-color:#C18A32; box-shadow:0 0 0 7rpx rgba(193,138,50,.16); }.person-node.is-viewpoint.is-selected { border-color:#245C4A; box-shadow:0 0 0 8rpx rgba(193,138,50,.2),0 0 0 15rpx rgba(36,92,74,.12); }.node-avatar { width:52rpx; height:52rpx; margin-bottom:6rpx; border-radius:18rpx; }.node-placeholder,.person-sheet-placeholder,.small-avatar { display:flex; align-items:center; justify-content:center; color:#245C4A; background:#E4EFEA; font-weight:600; }.node-placeholder { font-size:26rpx; }.node-name { max-width:144rpx; overflow:hidden; color:#202824; font-size:28rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.node-meta { max-width:144rpx; margin-top:2rpx; overflow:hidden; color:#65706A; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.branch-count,.node-action-trigger { position:absolute; z-index:6; display:flex; align-items:center; justify-content:center; color:#FFFEFA; border:4rpx solid #F7F4EC; font-weight:600; white-space:nowrap; }.branch-count { right:-18rpx; bottom:-22rpx; min-width:72rpx; height:38rpx; padding:0 12rpx; background:#245C4A; border-radius:22rpx; font-size:20rpx; }.node-action-trigger { top:-22rpx; right:-20rpx; width:52rpx; height:44rpx; background:#C18A32; border-radius:24rpx; font-size:24rpx; letter-spacing:-2rpx; }.graph-movable.zoom-compact .node-meta { display:none; }.graph-movable.zoom-overview .node-avatar,.graph-movable.zoom-overview .node-meta { display:none; }.graph-movable.zoom-overview .person-node { justify-content:center; padding:12rpx; border-width:4rpx; box-shadow:none; }.graph-movable.zoom-overview .node-name { font-size:32rpx; }.graph-movable.zoom-overview .relation-line:not(.relation-flow) { opacity:.72; }
.graph-help { position:fixed; left:50%; bottom:calc(128rpx + env(safe-area-inset-bottom)); z-index:20; max-width:620rpx; padding:14rpx 24rpx; transform:translateX(-50%); color:#65706A; background:rgba(255,254,250,.94); border:2rpx solid #D8DED9; border-radius:40rpx; font-size:24rpx; white-space:nowrap; }.create { position:fixed; right:32rpx; bottom:calc(28rpx + env(safe-area-inset-bottom)); left:32rpx; z-index:21; width:auto; }.sheet-mask,.tour-mask { position:fixed; z-index:30; inset:0; display:flex; align-items:flex-end; background:rgba(23,35,31,.42); }.bottom-sheet { width:100%; max-height:80vh; padding:32rpx; background:#FFFEFA; border-radius:32rpx 32rpx 0 0; }.sheet-handle { width:72rpx; height:8rpx; margin:0 auto 24rpx; background:#D8DED9; border-radius:9rpx; }.person-sheet-head { margin-bottom:28rpx; display:flex; align-items:center; }.person-sheet-avatar { width:112rpx; height:112rpx; margin-right:24rpx; border-radius:32rpx; }.person-sheet-copy { display:flex; flex-direction:column; }.person-sheet-name { margin-bottom:8rpx; font-size:42rpx; font-weight:600; }.action-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }.action-cell { min-height:136rpx; padding:24rpx; display:flex; flex-direction:column; justify-content:center; background:#F7F4EC; border:2rpx solid #E3E6E2; border-radius:22rpx; }.action-cell-wide { grid-column:1 / -1; }.action-title { margin-bottom:8rpx; font-weight:600; }.action-desc { color:#65706A; font-size:24rpx; }.perspective-sheet { height:72vh; }.person-search { height:88rpx; padding:0 24rpx; background:#F3F2EC; border:2rpx solid #D8DED9; border-radius:22rpx; }.perspective-list { height:calc(72vh - 190rpx); margin-top:16rpx; }.perspective-option { min-height:104rpx; padding:20rpx; display:flex; align-items:center; border-bottom:2rpx solid #EEF0ED; }.small-avatar { width:64rpx; height:64rpx; margin-right:20rpx; border-radius:20rpx; }.tour-mask { align-items:center; justify-content:center; padding:40rpx; }.tour-card { width:10