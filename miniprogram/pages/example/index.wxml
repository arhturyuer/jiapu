<wxs module="graphGesture" src="../../wxs/graph-gesture.wxs" />
<import src="../../templates/kinship-card.wxml" />
<page-meta page-orientation="{{pageOrientation}}" bindresize="onPageResize"></page-meta>
<view class="reading-root navigation-graph {{readingLarge ? 'reading-graph-page' : ''}} {{elderMode ? 'reading-elder' : ''}} {{readingLarge ? 'reading-large' : ''}}" style="{{readingStyle}}{{readingDockStyle}}--navigation-height:{{navigationHeight}}px;">
<page-navigation title="有谱家谱·微信云开发·安全可靠" back bindlayout="onNavigationLayout" />
<view class="example-page {{isLandscape && !isLargeDevice ? 'is-landscape' : ''}} {{isLargeDevice ? 'is-large-device' : ''}} {{isCleanScreen ? 'is-clean-screen' : ''}}">
<view class="reading-graph-tools" wx:if="{{elderMode && !isCleanScreen && nodes.length}}">
  <button bindtap="openReadingPeople">找家人</button><button bindtap="zoomGraphIn" aria-label="放大家谱">放大</button><button bindtap="zoomGraphOut" aria-label="缩小家谱">缩小</button><button bindtap="lookClearly">看清姓名</button><button bindtap="toggleReadingMore">更多</button>
</view>
<view class="sheet-mask" wx:if="{{elderMode && showReadingMore && !isCleanScreen}}" bindtap="toggleReadingMore"><view class="bottom-sheet reading-more" catchtap="noop"><text class="sheet-title">家谱操作</text><button class="secondary-button" data-action="fitWholeGraph" bindtap="readingMoreAction">查看整张家谱</button><button class="secondary-button" data-action="openDisplaySettings" bindtap="readingMoreAction">家谱显示设置</button><button class="secondary-button" data-action="generatePoster" bindtap="readingMoreAction" disabled="{{posterGenerating}}">导出图片</button><button class="secondary-button" data-action="openPdfExport" bindtap="readingMoreAction">导出 PDF</button><button class="secondary-button" wx:if="{{!isLargeDevice}}" data-action="togglePageOrientation" bindtap="readingMoreAction">切换横竖屏</button><button class="secondary-button" data-action="toggleCleanScreen" bindtap="readingMoreAction">清屏浏览</button><button class="secondary-button" bindtap="toggleReadingMore">关闭</button></view></view>
  <view class="example-header">
    <view class="example-create-actions"><button class="primary-button create" bindtap="createFamily">创建我的家谱</button><button class="secondary-button switch-example" bindtap="openExamples">切换示例</button></view>
    <view class="example-selector">
      <view class="example-divider"><view class="example-divider-line"></view><text class="example-subtitle">以下为示例家谱</text><view class="example-divider-line"></view></view>
      <scroll-view class="example-tabs" scroll-x show-scrollbar="{{false}}" scroll-into-view="{{selectedExampleTabId}}" scroll-with-animation>
        <view class="example-tab-list"><view data-reading-control="true" aria-role="button" wx:for="{{exampleTabs}}" wx:key="slug" id="{{item.id}}" class="example-tab {{item.slug === slug ? 'selected' : ''}}" data-slug="{{item.slug}}" bindtap="selectExampleTab" aria-label="{{item.slug === slug ? '已选择，' : ''}}{{item.title}}">{{item.title}}</view></view>
      </scroll-view>
      <text data-reading-control="true" aria-role="button" class="example-tabs-error" wx:if="{{tabsError}}" bindtap="retryExampleTabs">{{tabsError}}</text>
    </view>
    <view class="example-toolbar {{loading || error ? 'is-disabled' : ''}}"><view class="mode-switch"><view data-reading-control="true" aria-role="button" class="mode-item {{viewMode === 'full' ? 'active' : ''}}" bindtap="showFullGraph">全谱</view><view data-reading-control="true" aria-role="button" class="mode-item {{viewMode === 'perspective' ? 'active' : ''}}" bindtap="openPerspectiveSheet">{{viewMode === 'perspective' ? '从' + viewpointName + '看' : '以某人看'}}</view></view><button class="toolbar-share" size="mini" open-type="share" disabled="{{loading || error || !example}}">分享</button></view>
  </view>
  <view class="example-loading" wx:if="{{loading}}"><view aria-hidden="true" class="loading-dot"></view><text>正在打开示例家谱…</text></view>
  <view class="example-empty" wx:elif="{{error}}"><view class="empty-panel"><view class="empty-mark">!</view><text class="empty-title">示例暂不可用</text><text class="empty-description">{{error}}</text><button class="secondary-button empty-action" bindtap="loadExample">重新加载</button></view></view>
  <view prop="{{graphGestureConfig}}" change:prop="{{graphGesture.configure}}" request="{{graphGestureRequest}}" change:request="{{graphGesture.snapshot}}" bindtouchstart="{{graphGesture.start}}" catchtouchmove="{{graphGesture.move}}" bindtouchend="{{graphGesture.end}}" bindtouchcancel="{{graphGesture.cancel}}" class="graph-viewport" wx:elif="{{example}}"><view class="graph-movable {{graphZoomClass}}" style="width:{{canvasWidth}}rpx;height:{{canvasHeight}}rpx;"><view class="graph-canvas" style="width:{{canvasWidth}}rpx;height:{{canvasHeight}}rpx;" bindtap="{{graphGesture.tap}}" data-gesture-action="clearGraphSelection"><view wx:for="{{lines}}" wx:key="_id" aria-hidden="true" class="relation-line relation-{{item.lineRole}} {{item.isFlow ? 'relation-flow' : ''}}" style="{{item.style}}"><view class="flow-runner flow-step-{{item.flowStep}}" wx:if="{{item.isAnimatedFlow && !elderMode}}"></view></view><view wx:for="{{crossings}}" wx:key="_id" aria-hidden="true" class="line-crossing {{item.isSpouse ? 'is-spouse' : ''}}" style="{{item.style}}"></view><view wx:for="{{junctions}}" wx:key="_id" aria-hidden="true" class="family-junction {{item.isActive ? 'is-active' : ''}}" style="{{item.style}}"></view><view wx:for="{{nodes}}" wx:key="_id" class="person-node gender-surface {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}} {{nameLayout === 'vertical' ? 'node-vertical' : !showAvatar ? 'node-no-avatar' : ''}} {{item.lifeStatus === 'deceased' ? 'is-deceased' : ''}} {{item.isViewpoint ? 'is-viewpoint' : ''}} {{item.isSelected ? 'is-selected' : ''}}" style="{{item.style}}" data-id="{{item._id}}" catchtap="{{graphGesture.tap}}" data-gesture-action="showPerson" aria-role="button" aria-label="{{item.name + (item.relationLabel ? '，' + item.relationLabel : '') + '，查看资料和操作'}}"><text class="gender-badge gender-node-badge {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}}" wx:if="{{showGenderBadge}}">{{item.genderText}}</text><text class="life-status-badge" wx:if="{{item.lifeStatus === 'deceased'}}">故</text><block wx:if="{{nameLayout === 'vertical'}}"><view class="node-name-columns"><text wx:for="{{item.nameColumns}}" wx:for-item="column" wx:key="index" class="node-name node-name-vertical">{{column}}</text></view><text class="node-meta node-kinship" wx:if="{{viewMode === 'perspective' && item.relationLabel}}">{{item.relationLabel}}</text></block><block wx:else><block wx:if="{{showAvatar}}"><image class="node-avatar gender-avatar {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}}" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" data-id="{{item._id}}" data-url="{{item.avatar}}" binderror="onNodeAvatarError"></image><image class="node-avatar gender-avatar {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}}" wx:elif="{{emptyAvatarStyle === 'default'}}" src="/images/system-avatar-{{showGenderColors && (item.gender === 'male' || item.gender === 'female') ? item.gender : 'neutral'}}.png" mode="aspectFill"></image><view class="node-avatar node-placeholder gender-avatar {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}}" style="font-size:calc({{item.surnameFontSize}}rpx * var(--graph-content-scale, 1));white-space:nowrap;line-height:1;" wx:else>{{item.surname}}</view></block><view class="node-name-lines"><text wx:for="{{item.nameLines}}" wx:for-item="nameLine" wx:key="index" class="node-name">{{nameLine}}</text></view><text class="node-meta" wx:if="{{viewMode === 'perspective' && item.relationLabel}}">{{item.relationLabel}}</text><text class="node-meta" wx:elif="{{item.metaText}}">{{item.metaText}}</text></block><text class="node-kinship-multiple" wx:if="{{viewMode === 'perspective' && item.hasMultipleKinships}}">多重关系</text><text class="child-rank-badge" wx:if="{{showChildRankBadge && item.childRankLabel}}">{{item.childRankLabel}}</text><view class="node-action-trigger" wx:if="{{item.isSelected}}" data-id="{{item._id}}" catchtap="{{graphGesture.tap}}" data-gesture-action="openMemberActions">•••</view><view class="branch-count" wx:if="{{item.hiddenDescendantCount > 0}}" data-id="{{item._id}}" catchtap="{{graphGesture.tap}}" data-gesture-action="expandBranch">+{{item.hiddenDescendantCount}} 人</view></view></view></view></view>
  <view class="graph-controls" wx:if="{{!elderMode && !loading && !error && example}}"><view data-reading-control="true" aria-role="button" class="graph-control" bindtap="zoomGraphIn">＋</view><view data-reading-control="true" aria-role="button" class="graph-control" bindtap="zoomGraphOut">－</view><view data-reading-control="true" aria-role="button" class="graph-control graph-control-text" bindtap="fitWholeGraph">全谱</view><view data-reading-control="true" aria-role="button" wx:if="{{!isLargeDevice}}" class="graph-control graph-control-text orientation-control {{orientationChanging ? 'is-disabled' : ''}}" bindtap="togglePageOrientation">{{orientationChanging ? '切换中' : isLandscape ? '竖屏' : '横屏'}}</view><view data-reading-control="true" aria-role="button" class="graph-control graph-control-text" bindtap="openDisplaySettings">设置</view><view data-reading-control="true" aria-role="button" class="graph-control graph-control-text {{posterGenerating ? 'is-disabled' : ''}}" bindtap="generatePoster">图片</view><view data-reading-control="true" aria-role="button" class="graph-control graph-control-text" bindtap="openPdfExport">PDF</view><view data-reading-control="true" aria-role="button" class="graph-control {{orientationChanging ? 'is-disabled' : ''}}" bindtap="toggleCleanScreen" aria-label="清屏查看家谱"><view class="clean-screen-icon" aria-hidden="true"><view class="icon-corner top-left"></view><view class="icon-corner top-right"></view><view class="icon-corner bottom-left"></view><view class="icon-corner bottom-right"></view></view></view></view>
  <view class="graph-help" wx:if="{{!elderMode && !loading && !error && example}}"><text wx:if="{{selectedPersonId && !showMemberSheet}}">关系已高亮，再次点击成员或点“•••”进行操作</text><text wx:elif="{{hiddenBranchCount > 0}}">已收起 {{hiddenBranchCount}} 人，点击 +人数 可展开分支</text><text wx:else>{{isDesktop ? '左键拖动 · 按钮或 + / - 缩放 · 0 查看全谱' : viewMode === 'full' ? '拖动查看全谱，点击成员进行操作' : '当前从' + viewpointName + '查看关系'}}</text></view>
  <button class="clean-screen-exit" size="mini" wx:if="{{isCleanScreen}}" bindtap="toggleCleanScreen" aria-label="退出清屏"><text wx:if="{{elderMode}}">退出清屏</text><view class="clean-screen-icon is-exit" aria-hidden="true"><view class="icon-corner top-left"></view><view class="icon-corner top-right"></view><view class="icon-corner bottom-left"></view><view class="icon-corner bottom-right"></view></view></button>

  <view class="sheet-mask member-sheet-mask member-ad-measure" aria-hidden="true">
    <view class="bottom-sheet person-sheet">
      <view class="member-sheet-ad-placement">
        <view class="member-sheet-ad-slot member-sheet-ad-measure-slot"></view>
      </view>
    </view>
  </view>

  <view class="sheet-mask member-sheet-mask {{!showMemberSheet ? 'member-ad-hidden' : ''}}" wx:if="{{showMemberSheet || memberAdMounted}}" hidden="{{!showMemberSheet}}" bindtap="closeMemberSheet">
    <view class="bottom-sheet person-sheet" catchtap="">
      <view class="person-sheet-content">
        <view class="sheet-handle"></view>
        <view class="person-sheet-head">
          <view class="person-sheet-avatar person-sheet-placeholder gender-avatar {{showGenderColors && selectedPerson.gender !== 'unknown' ? selectedPerson.genderClass : 'gender-neutral'}} {{selectedPerson.lifeStatus === 'deceased' ? 'is-deceased-avatar' : ''}}">{{selectedPerson.initial}}</view>
          <view class="person-sheet-copy">
            <view class="person-sheet-name-row"><text class="person-sheet-name">{{selectedPerson.name}}</text><text class="gender-badge {{showGenderColors && selectedPerson.gender !== 'unknown' ? selectedPerson.genderClass : 'gender-neutral'}}" wx:if="{{showGenderBadge}}">{{selectedPerson.genderText}}</text><text class="person-sheet-life-status" wx:if="{{selectedPerson.lifeStatus === 'deceased'}}">故</text></view>
            <text class="person-rank-basis" wx:if="{{showChildRankBadge && selectedPerson.childRankLabel}}">{{selectedPerson.childRankLabel}}</text>
            <text class="muted-text">官方示例人物 · 只读</text>
          </view>
        </view>
        <template is="kinship-card" data="{{card: selectedKinship}}" />
        <view class="action-grid">
          <view data-reading-control="true" aria-role="button" class="action-cell" bindtap="useSelectedPerspective"><text class="action-title">从他/她看</text><text class="action-desc">切换成员视角</text></view>
          <view data-reading-control="true" aria-role="button" class="action-cell" bindtap="openMemberDetail"><text class="action-title">查看资料</text><text class="action-desc">关系与人物信息</text></view>
          <view data-reading-control="true" aria-role="button" class="action-cell" bindtap="toggleSelectedBranch" wx:if="{{selectedPerson.hasChildren}}"><text class="action-title">{{selectedPerson.isCollapsed ? '展开后代' : '折叠后代'}}</text><text class="action-desc">调整示例图谱分支</text></view>
        </view>
        <view class="member-relation-section">
          <text class="member-relation-title">添加亲属</text>
          <view class="member-relation-grid">
            <view data-reading-control="true" aria-role="button" class="member-relation-option" wx:for="{{selectedPerson.relationOptions}}" wx:key="key" data-type="{{item.key}}" bindtap="explainCreate">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="member-sheet-ad-placement {{!memberAdReserved ? 'member-ad-hidden' : ''}}" wx:if="{{memberAdReserved || memberAdMounted}}" hidden="{{!memberAdReserved}}">
        <view class="member-sheet-ad-header">
          <button class="member-sheet-ad-close" aria-label="关闭广告" bindtap="dismissMemberAd"><icon type="cancel" size="16" color="#65706A" /></button>
          <button class="member-sheet-membership-link" bindtap="openAdMembership">开会员，全家人免广告</button>
        </view>
        <view class="member-sheet-ad-slot member-sheet-ad-visible-slot">
          <view class="member-sheet-ad-placeholder" wx:if="{{!memberAdLoaded}}">广告位，收益用于运营开支</view>
          <view class="member-sheet-ad-content" style="width:{{memberAdWidth}}px;">
            <ad-custom class="member-sheet-ad {{!memberAdVisible ? 'member-ad-hidden' : ''}}" wx:if="{{memberAdMounted}}" hidden="{{!memberAdVisible}}" unit-id="{{memberAdUnitId}}" data-version="{{memberAdVersion}}" bindload="showMemberAd" binderror="hideMemberAd" bindclose="closeMemberAd"></ad-custom>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="sheet-mask" wx:if="{{showPerspectiveSheet}}" bindtap="closePerspectiveSheet"><view class="bottom-sheet perspective-sheet" catchtap=""><view class="sheet-handle"></view><view class="sheet-title">以某位成员看家谱</view><input aria-label="输入姓名查找" class="person-search" placeholder="输入姓名查找" value="{{perspectiveKeyword}}" bindinput="filterPerspectives"/><scroll-view class="perspective-list" scroll-y><view data-reading-control="true" aria-role="button" class="perspective-option" wx:for="{{perspectiveResults}}" wx:key="_id" data-id="{{item._id}}" bindtap="selectPerspective"><view class="small-avatar gender-avatar {{item.genderClass}}">{{item.initial}}</view><text class="perspective-name">{{item.name}}</text><text class="gender-badge {{item.genderClass}}">{{item.genderText}}</text></view></scroll-view></view></view>
</view>
<canvas type="2d" id="example-share-card" class="share-card-canvas"></canvas>
<canvas type="2d" id="example-poster-canvas" class="tree-poster-canvas"></canvas>
<view class="poster-generating" wx:if="{{posterGenerating}}"><view aria-hidden="true" class="loading-dot"></view><text>正在生成图片</text></view>

<view class="graph-unit-probe" aria-hidden="true"></view>
</view>
