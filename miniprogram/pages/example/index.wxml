<import src="../../templates/kinship-card.wxml" />
<page-meta page-orientation="{{pageOrientation}}" bindresize="onPageResize"></page-meta>
<view class="loading-panel" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在打开示例家谱…</text></view>
<view class="page-shell" wx:elif="{{error}}"><view class="empty-panel"><view class="empty-mark">!</view><text class="empty-title">示例暂不可用</text><text class="empty-description">{{error}}</text><button class="secondary-button empty-action" bindtap="loadExample">重新加载</button><button class="primary-button empty-action" bindtap="createFamily">创建我的家谱</button></view></view>
<view class="example-page {{isLandscape ? 'is-landscape' : ''}}" wx:elif="{{example}}">
  <view class="example-header"><view class="example-identity"><text class="example-title">{{example.title}}</text><text class="example-subtitle">官方虚构示例 · 只读体验</text></view><view class="example-actions"><view class="mode-switch"><view class="mode-item {{viewMode === 'full' ? 'active' : ''}}" bindtap="showFullGraph">全谱</view><view class="mode-item {{viewMode === 'perspective' ? 'active' : ''}}" bindtap="openPerspectiveSheet">{{viewMode === 'perspective' ? '从' + viewpointName + '看' : '以某人看'}}</view></view><button class="toolbar-share" open-type="share">分享</button></view></view>
  <movable-area class="graph-viewport"><movable-view class="graph-movable {{graphZoomClass}}" style="width:{{canvasWidth}}rpx;height:{{canvasHeight}}rpx;" direction="all" x="{{graphX}}" y="{{graphY}}" scale="true" scale-value="{{graphScale}}" scale-min="{{graphScaleMin}}" scale-max="1.6" inertia="{{false}}" animation="{{false}}" bindscale="onGraphScale" bindchange="onGraphChange"><view class="graph-canvas" style="width:{{canvasWidth}}rpx;height:{{canvasHeight}}rpx;" bindtap="clearGraphSelection"><view wx:for="{{lines}}" wx:key="_id" class="relation-line relation-{{item.lineRole}} {{item.isFlow ? 'relation-flow' : ''}}" style="{{item.style}}"><view class="flow-runner flow-step-{{item.flowStep}}" wx:if="{{item.isAnimatedFlow}}"></view></view><view wx:for="{{junctions}}" wx:key="_id" class="family-junction {{item.isActive ? 'is-active' : ''}}" style="{{item.style}}"></view><view wx:for="{{nodes}}" wx:key="_id" class="person-node gender-surface {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}} {{nameLayout === 'vertical' ? 'node-vertical' : ''}} {{item.lifeStatus === 'deceased' ? 'is-deceased' : ''}} {{item.isViewpoint ? 'is-viewpoint' : ''}} {{item.isSelected ? 'is-selected' : ''}}" style="{{item.style}}" data-id="{{item._id}}" catchtap="showPerson"><text class="gender-badge gender-node-badge {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}}" wx:if="{{showGenderBadge}}">{{item.genderText}}</text><text class="life-status-badge" wx:if="{{item.lifeStatus === 'deceased'}}">故</text><block wx:if="{{nameLayout === 'vertical'}}"><text class="node-name node-name-vertical">{{item.verticalName}}</text><text class="node-meta node-kinship" wx:if="{{viewMode === 'perspective' && item.relationLabel}}">{{item.relationLabel}}</text></block><block wx:else><view class="node-avatar node-placeholder gender-avatar {{showGenderColors && item.gender !== 'unknown' ? item.genderClass : 'gender-neutral'}} {{item.lifeStatus === 'deceased' ? 'is-deceased-avatar' : ''}}">{{item.initial}}</view><text class="node-name">{{item.name}}</text><text class="node-meta" wx:if="{{viewMode === 'perspective' && item.relationLabel}}">{{item.relationLabel}}</text><text class="node-meta" wx:elif="{{item.metaText}}">{{item.metaText}}</text></block><text class="node-kinship-multiple" wx:if="{{viewMode === 'perspective' && item.hasMultipleKinships}}">多重关系</text><text class="child-rank-badge" wx:if="{{showChildRankBadge && item.childRankLabel}}">{{item.childRankLabel}}</text><view class="node-action-trigger" wx:if="{{item.isSelected}}" data-id="{{item._id}}" catchtap="openMemberActions">•••</view><view class="branch-count" wx:if="{{item.hiddenDescendantCount > 0}}" data-id="{{item._id}}" catchtap="expandBranch">+{{item.hiddenDescendantCount}} 人</view></view></view></movable-view></movable-area>
  <view class="graph-controls"><view class="graph-control" bindtap="zoomGraphIn">＋</view><view class="graph-control" bindtap="zoomGraphOut">－</view><view class="graph-control graph-control-text" bindtap="fitWholeGraph">全谱</view><view class="graph-control graph-control-text orientation-control {{orientationChanging ? 'is-disabled' : ''}}" bindtap="togglePageOrientation">{{orientationChanging ? '切换中' : isLandscape ? '竖屏' : '横屏'}}</view><view class="graph-control graph-control-text" bindtap="openDisplaySettings">设置</view><view class="graph-control graph-control-text {{posterGenerating ? 'is-disabled' : ''}}" bindtap="generatePoster">图片</view></view>
  <view class="graph-help"><text wx:if="{{selectedPersonId && !showMemberSheet}}">关系已高亮，再次点击成员或点“•••”进行操作</text><text wx:elif="{{hiddenBranchCount > 0}}">已智能收起 {{hiddenBranchCount}} 人，点击 +人数 可展开分支</text><text wx:else>{{viewMode === 'full' ? '拖动查看全谱，点击成员进行操作' : '当前从' + viewpointName + '查看关系'}}</text></view>
  <button class="primary-button create" bindtap="createFamily">用这个示例开始创建我的家谱</button>
  <view class="sheet-mask" wx:if="{{showMemberSheet}}" bindtap="closeMemberSheet"><view class="bottom-sheet person-sheet" catchtap=""><view class="sheet-handle"></view><view class="person-sheet-head"><view class="person-sheet-avatar person-sheet-placeholder gender-avatar {{showGenderColors && selectedPerson.gender !== 'unknown' ? selectedPerson.genderClass : 'gender-neutral'}} {{selectedPerson.lifeStatus === 'deceased' ? 'is-deceased-avatar' : ''}}">{{selectedPerson.initial}}</view><view class="person-sheet-copy"><view class="person-sheet-name-row"><text class="person-sheet-name">{{selectedPerson.name}}</text><text class="gender-badge {{showGenderColors && selectedPerson.gender !== 'unknown' ? selectedPerson.genderClass : 'gender-neutral'}}" wx:if="{{showGenderBadge}}">{{selectedPerson.genderText}}</text><text class="person-sheet-life-status" wx:if="{{selectedPerson.lifeStatus === 'deceased'}}">故</text></view><text class="person-rank-basis" wx:if="{{showChildRankBadge && selectedPerson.childRankLabel}}">{{selectedPerson.childRankLabel}}</text><text class="muted-text">官方示例人物 · 只读</text></view></view><template is="kinship-card" data="{{card: selectedKinship}}" />
      <view class="action-grid"><view class="action-cell" bindtap="useSelectedPerspective"><text class="action-title">从他/她看</text><text class="action-desc">切换成员视角</text></view><view class="action-cell" bindtap="openMemberDetail"><text class="action-title">查看资料</text><text class="action-desc">关系与人物信息</text></view><view class="action-cell" bindtap="toggleSelectedBranch"><text class="action-title">{{selectedPerson.isCollapsed ? '展开后代' : '折叠后代'}}</text><text class="action-desc">调整示例图谱分支</text></view><view class="action-cell" bindtap="explainCreate"><text class="action-title">添加亲属</text><text class="action-desc">创建后即可使用</text></view><view class="action-cell action-cell-wide" bindtap="explainCreate"><text class="action-title">编辑资料</text><text class="action-desc">在自己的家谱中补充或纠正资料</text></view></view></view></view>
  <view class="sheet-mask" wx:if="{{showPerspectiveSheet}}" bindtap="closePerspectiveSheet"><view class="bottom-sheet perspective-sheet" catchtap=""><view class="sheet-handle"></view><view class="sheet-title">以某位成员看家谱</view><input class="person-search" placeholder="输入姓名查找" value="{{perspectiveKeyword}}" bindinput="filterPerspectives"/><scroll-view class="perspective-list" scroll-y><view class="perspective-option" wx:for="{{perspectiveResults}}" wx:key="_id" data-id="{{item._id}}" bindtap="selectPerspective"><view class="small-avatar gender-avatar {{item.genderClass}}">{{item.initial}}</view><text class="perspective-name">{{item.name}}</text><text class="gender-badge {{item.genderClass}}">{{item.genderText}}</text></view></scroll-view></view></view>
  <view class="tour-mask" wx:if="{{showTour}}"><view class="tour-card"><text class="tour-count">{{tourStep}} / 3</text><text class="tour-title">{{tourStep === 1 ? '这是一张完整家谱图' : tourStep === 2 ? '点一位家人看看资料' : '切换视角，理解不同关系'}}</text><text class="tour-copy">{{tourStep === 1 ? '用双指缩放、拖动画布查看全家关系。' : tourStep === 2 ? '先选中，再次点击人物查看资料和操作。' : '选择任意成员，关系称谓会围绕他/她变化。'}}</text><view class="tour-actions"><button class="secondary-button" bindtap="dismissTour">跳过</button><button class="primary-button" bindtap="nextTour">{{tourStep === 3 ? '开始体验' : '下一步'}}</button></view></view></view>
</view>
<canvas type="2d" id="example-share-card" class="share-card-canvas"></canvas>
<canvas type="2d" id="example-poster-canvas" class="tree-poster-canvas"></canvas>
<view class="poster-generating" wx:if="{{posterGenerating}}"><view class="loading-dot"></view><text>正在生成图片</text></view>
