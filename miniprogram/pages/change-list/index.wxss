.change-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.page-intro { padding: 8rpx 4rpx 24rpx; }
.intro-title, .intro-copy { display: block; }
.intro-title { font-size: var(--reading-font-19, 19px); font-weight: 650; }
.intro-copy { margin-top: 8rpx; color: #65706A; font-size: var(--reading-font-13, 14px); }
.status-tabs { height: 82rpx; padding: 6rpx; display: flex; background: #E8ECE8; border-radius: 24rpx; }
.status-tab { flex: 1; display: flex; align-items: center; justify-content: center; color: #65706A; border-radius: 19rpx; font-size: var(--reading-font-13_5, 14px); font-weight: 600; }
.status-tab.active { color: #245C4A; background: #FFFEFA; box-shadow: 0 5rpx 14rpx rgba(38, 55, 48, 0.08); }
.change-list { margin-top: 24rpx; }
.change-card { margin-bottom: 16rpx; padding: 26rpx; }
.change-head { display: flex; align-items: flex-start; gap: 18rpx; }
.change-title { min-width: 0; flex: 1; font-weight: 600; line-height: 1.5; }
.change-status { min-height: 44rpx; padding: 5rpx 14rpx; flex: none; color: #65706A; background: #EEF0ED; border-radius: 999rpx; font-size: var(--reading-font-11, 14px); font-weight: 600; }
.change-status.pending { color: #A15B22; background: #FFF0E2; }
.change-status.approved { color: #245C4A; background: #E4EFEA; }
.change-status.rejected { color: #B43D3D; background: #FBEDEC; }
.change-meta { margin-top: 10rpx; display: block; color: #65706A; font-size: var(--reading-font-12, 14px); }
.review-note { margin-top: 16rpx; padding: 16rpx 18rpx; display: block; color: #65706A; background: #F5F3ED; border-radius: 16rpx; font-size: var(--reading-font-12_5, 14px); }
.review-actions { margin-top: 22rpx; display: flex; justify-content: flex-end; gap: 12rpx; }
.review-button { width: 144rpx; height: 68rpx; margin: 0; padding: 0; display: flex; flex: none; align-items: center; justify-content: center; border-radius: 18rpx; font-size: var(--reading-font-13, 14px); font-weight: 600; line-height: 1; }
.review-button.reject { color: #B43D3D; background: #FBEDEC; }
.review-button.approve { color: #FFFFFF; background: #245C4A; }
.review-button[disabled] { opacity: 0.58; }
.more-button { width: 100%; margin-top: 10rpx; }
.empty-state { margin-top: 24rpx; padding: 70rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.empty-state-mark { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; border-radius: 32rpx; font-size: var(--reading-font-20, 20px); font-weight: 650; }
.empty-state-title { margin-top: 24rpx; font-weight: 600; }
.empty-state-copy { margin-top: 10rpx; color: #65706A; font-size: var(--reading-font-13, 14px); }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .change-page { padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
  .page-intro { padding: 4px 2px 12px; }
  .intro-copy { margin-top: 4px; }
  .status-tabs { height: 41px; padding: 3px; border-radius: 12px; }
  .status-tab { border-radius: 9.5px; }
  .status-tab.active { box-shadow: 0 2.5px 7px rgba(38, 55, 48, 0.08); }
  .change-list { margin-top: 12px; }
  .change-card { margin-bottom: 8px; padding: 13px; }
  .change-head { gap: 9px; }
  .change-status { min-height: 22px; padding: 2.5px 7px; border-radius: 499.5px; }
  .change-meta { margin-top: 5px; }
  .review-note { margin-top: 8px; padding: 8px 9px; border-radius: 8px; }
  .review-actions { margin-top: 11px; gap: 6px; }
  .review-button { width: 72px; height: 34px; border-radius: 9px; }
  .more-button { margin-top: 5px; }
  .empty-state { margin-top: 12px; padding: 35px 16px; }
  .empty-state-mark { width: 48px; height: 48px; border-radius: 16px; }
  .empty-state-title { margin-top: 12px; }
  .empty-state-copy { margin-top: 5px; }
}
/* large-screen:end */
