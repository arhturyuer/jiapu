page { background:#F7F4EC; }
.launch-page { width:100%; background:#F7F4EC; }
.launch-safe-top { width:100%; }
.launch-content { width:100%; display:flex; align-items:center; justify-content:center; }
.launch-template { flex:none; margin:0 auto; }
.launch-native-ad { display:block; width:100%; }
.launch-logo { display:block; width:160rpx; height:160rpx; border-radius:36rpx; }
.launch-brand { display:block; color:#245C4A; font-size:40rpx; font-weight:600; line-height:1.4; letter-spacing:4rpx; }
.launch-brand-stage { width:100%; display:flex; flex-direction:column; }
.launch-brand-space-top { flex:4 1 0; }
.launch-brand-space-bottom { flex:6 1 0; }
.launch-status { flex:none; padding:0 24rpx; display:flex; flex-direction:column; align-items:center; gap:24rpx; text-align:center; }
.launch-page button.launch-retry { margin:24rpx 0 0; padding:0 32rpx; color:#245C4A; background:#FFFEFA; border:2rpx solid #86A99A; border-radius:24rpx; font-size:28rpx; }
.launch-actions { width:100%; background:#FFFEFA; }
.launch-action-buttons { min-height:232rpx; padding:20rpx 32rpx; display:flex; flex-direction:column; gap:16rpx; justify-content:flex-end; }
.launch-page .launch-actions button.launch-skip,.launch-page .launch-actions button.launch-membership { width:100%; max-width:none; height:88rpx; min-height:88rpx; margin:0; padding:0 16rpx; display:flex; align-items:center; justify-content:center; border-radius:24rpx; font-size:26rpx; line-height:1.2; }
.launch-page .launch-actions button.launch-skip { border:2rpx solid #86A99A; color:#245C4A; background:#FFFEFA; }
.launch-page .launch-actions button.launch-membership { color:#FFFFFF; background:#245C4A; }
