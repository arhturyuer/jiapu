<view class="loading-panel" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在加载我的资料…</text></view>
<view class="page-shell" wx:elif="{{error}}"><view class="empty-panel"><view class="empty-mark">!</view><text class="empty-title">暂时无法打开我的页面</text><text class="empty-description">{{error}}</text><button class="primary-button empty-action" bindtap="loadPage">重新加载</button></view></view>
<view class="profile-page page-shell" wx:else>
  <view class="pending-card surface-card" wx:if="{{accountState === 'pending_delete'}}">
    <text class="pending-title">账户正在注销冷静期</text><text class="pending-desc">冷静期结束后会匿名化你的账户资料。期间不能修改资料、创建或管理家谱。</text>
    <button class="primary-button" bindtap="showPrivacy">查看注销状态或撤销</button>
    <button class="contact-button" open-type="contact">联系微信客服</button>
  </view>

  <block wx:elif="{{!familyList.length}}">
    <view class="empty-panel profile-empty"><view class="empty-mark">家</view><text class="empty-title">从第一位家人开始</text><text class="empty-description">几分钟建立第一张家谱，再邀请家人一起补完整。</text><view class="empty-guide-actions"><button class="primary-button empty-action" bindtap="createFamily">创建家谱</button><button class="secondary-button empty-action" bindtap="openExamples">浏览示例家谱</button><text class="invite-help" bindtap="explainInvitation">收到家人邀请，在微信中打开邀请卡片</text></view><view class="archived-empty-list surface-card" wx:if="{{archivedFamilies.length}}"><view class="setting-row" wx:for="{{archivedFamilies}}" wx:key="_id" data-id="{{item._id}}" bindtap="openArchivedFamily"><view><text class="setting-title">{{item.name}}</text><text class="setting-desc">{{item.archiveStatusText}}</text></view><text class="setting-arrow">›</text></view></view></view>
  </block>

  <block wx:else>
    <view class="profile-card surface-card">
      <button class="avatar-btn {{savingAvatar ? 'avatar-btn-loading' : ''}}" bindtap="chooseAvatar" hover-class="avatar-btn-active" loading="{{savingAvatar}}">
        <image class="profile-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="profile-avatar profile-placeholder" wx:else>家</view>
      </button>
      <view class="profile-form">
        <input class="nickname-input" type="text" placeholder="输入名字" value="{{nickName}}" bindinput="inputNickname" maxlength="30" />
        <button class="primary-button save-btn" wx:if="{{hasNameChanges}}" disabled="{{savingProfile || savingAvatar}}" loading="{{savingProfile}}" bindtap="saveProfile">保存名字</button>
      </view>
    </view>

    <view class="section-block"><view class="section-heading"><text class="section-title">当前家谱</text><text class="section-action" bindtap="openFamilySheet">切换</text></view><view class="current-family-card surface-card"><view><text class="current-family-name">{{currentFamily.name}}</text><text class="current-family-meta">{{currentRoleText}} · {{currentFamily.personCount}} 位成员</text><text class="current-family-updated" wx:if="{{currentFamilyUpdatedText}}">{{currentFamilyUpdatedText}}</text></view><button class="primary-button open-graph-button" bindtap="openCurrentGraph">查看家谱</button></view></view>

    <view class="section-block" wx:if="{{archivedFamilies.length}}"><view class="section-heading"><text class="section-title">家谱回收站</text><text class="muted-text">到期前可恢复</text></view><view class="setting-list surface-card"><view class="setting-row" wx:for="{{archivedFamilies}}" wx:key="_id" data-id="{{item._id}}" bindtap="openArchivedFamily" hover-class="setting-row-active"><view><text class="setting-title">{{item.name}}</text><text class="setting-desc">{{item.archiveStatusText}}</text></view><text class="setting-arrow">›</text></view></view></view>

    <view class="section-block"><view class="section-heading"><text class="section-title">我的家谱</text><text class="section-action" bindtap="createFamily">新建</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="openFamilySheet" hover-class="setting-row-active"><view><text class="setting-title">切换家谱</text><text class="setting-desc">已加入 {{familyList.length}} 份家谱</text></view><text class="setting-arrow">›</text></view><view class="setting-row" bindtap="openFamilyManage" hover-class="setting-row-active"><view><text class="setting-title">家庭管理</text><text class="setting-desc">成员角色、邀请和家谱归档</text></view><text class="setting-arrow">›</text></view></view></view>

    <view class="section-block"><view class="section-heading"><text class="section-title">帮助与反馈</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="showFeedbackGroup" hover-class="setting-row-active"><view><text class="setting-title">用户反馈群</text><text class="setting-desc">长按识别二维码，加入微信群反馈问题</text></view><text class="setting-arrow">›</text></view></view></view>

    <view class="section-block"><view class="section-heading"><text class="section-title">账户与数据</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="showPrivacy" hover-class="setting-row-active"><view><text class="setting-title">隐私与账户</text><text class="setting-desc">管理权限、个人数据和账户状态</text></view><text class="setting-arrow">›</text></view><view class="setting-row" bindtap="showAbout" hover-class="setting-row-active"><view><text class="setting-title">关于有谱</text><text class="setting-desc">产品理念与版本信息</text></view><text class="setting-arrow">›</text></view></view></view>
  </block>
  <view class="section-block" wx:if="{{accountState === 'pending_delete'}}"><view class="section-heading"><text class="section-title">帮助与反馈</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="showFeedbackGroup" hover-class="setting-row-active"><view><text class="setting-title">用户反馈群</text><text class="setting-desc">长按识别二维码，加入微信群反馈问题</text></view><text class="setting-arrow">›</text></view></view></view>
  <view class="sheet-mask" wx:if="{{showFamilySheet}}" bindtap="closeFamilySheet"><view class="bottom-sheet" catchtap="stopEvent"><view class="sheet-handle"></view><view class="sheet-title">切换家谱</view><view class="family-option {{currentFamily && item._id === currentFamily._id ? 'selected' : ''}}" wx:for="{{familyList}}" wx:key="_id" data-id="{{item._id}}" bindtap="switchFamily"><view><text class="family-option-name">{{item.name}}</text><text class="family-option-role">{{item.currentRole === 'admin' ? '家谱管理员' : item.currentRole === 'member' ? '家庭成员' : '访客'}} · {{item.personCount}} 位成员</text></view><text class="selected-text" wx:if="{{currentFamily && item._id === currentFamily._id}}">当前</text></view><button class="secondary-button create-family-button" bindtap="createFamily">创建另一份家谱</button></view></view>
</view>
