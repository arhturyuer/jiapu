<view class="loading-panel" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在加载我的资料…</text></view>
<view class="page-shell" wx:elif="{{error}}"><view class="empty-panel"><view class="empty-mark">!</view><text class="empty-title">暂时无法打开我的页面</text><text class="empty-description">{{error}}</text><button class="primary-button empty-action" bindtap="loadPage">重新加载</button></view></view>
<view class="profile-page page-shell" wx:else>
  <view class="pending-card surface-card" wx:if="{{accountState === 'pending_delete'}}">
    <text class="pending-title">账户正在注销冷静期</text><text class="pending-desc">冷静期结束后会清除你的账户资料，并去除必要记录与你身份的关联。期间不能修改资料、创建或管理家谱。</text>
    <button class="primary-button" bindtap="showPrivacy">查看注销状态或撤销</button>
    <button class="contact-button" open-type="contact">联系微信客服</button>
  </view>

  <block wx:else>
    <view class="profile-card surface-card">
      <button class="avatar-btn {{savingAvatar ? 'avatar-btn-loading' : ''}}" bindtap="chooseAvatar" hover-class="avatar-btn-active" loading="{{savingAvatar}}">
        <image class="profile-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="profile-avatar profile-placeholder" wx:else>我</view>
      </button>
      <view class="profile-form">
        <input class="nickname-input" type="text" placeholder="输入名字" value="{{nickName}}" bindinput="inputNickname" maxlength="30" />
        <button class="primary-button save-btn" wx:if="{{hasNameChanges}}" disabled="{{savingProfile || savingAvatar}}" loading="{{savingProfile}}" bindtap="saveProfile">保存名字</button>
      </view>
    </view>

    <view class="section-block"><view class="section-heading"><text class="section-title">账户与隐私</text></view><view class="setting-list surface-card">
      <view class="setting-row" bindtap="showPrivacy" hover-class="setting-row-active"><view><text class="setting-title">隐私与账户</text><text class="setting-desc">管理授权、个人数据和账户状态</text></view><text class="setting-arrow">›</text></view>
      <view class="setting-row" bindtap="showAbout" hover-class="setting-row-active"><view><text class="setting-title">关于有谱</text><text class="setting-desc">产品理念与版本信息</text></view><text class="setting-arrow">›</text></view>
      <view class="setting-row setting-share-row" hover-class="setting-row-active"><view class="setting-share-copy"><text class="setting-title">分享有谱</text><text class="setting-desc">向朋友推荐有谱家谱小程序</text></view><text class="setting-arrow">›</text><button class="setting-share-hit" open-type="share" hover-class="setting-row-active" aria-label="分享有谱家谱"></button></view>
    </view></view>

    <view class="section-block"><view class="section-heading"><text class="section-title">帮助与反馈</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="showFeedbackGroup" hover-class="setting-row-active"><view><text class="setting-title">用户反馈群</text><text class="setting-desc">长按识别二维码，加入微信群反馈问题</text></view><text class="setting-arrow">›</text></view></view></view>
    <view class="ad-placement {{adLoaded ? '' : 'ad-placement-loading'}}" wx:if="{{adVisible}}">
      <ad class="banner-ad" wx:if="{{adVisible}}" unit-id="{{adUnitId}}" data-version="{{adVersion}}" bindload="showAd" binderror="hideAd"></ad>
      <button class="ad-membership-link" wx:if="{{adVisible && adLoaded}}" bindtap="openAdMembership">开通家庭会员，全体家人免广告 ›</button>
    </view>
  </block>

  <view class="section-block" wx:if="{{accountState === 'pending_delete'}}"><view class="section-heading"><text class="section-title">帮助与反馈</text></view><view class="setting-list surface-card"><view class="setting-row" bindtap="showFeedbackGroup" hover-class="setting-row-active"><view><text class="setting-title">用户反馈群</text><text class="setting-desc">长按识别二维码，加入微信群反馈问题</text></view><text class="setting-arrow">›</text></view></view></view>
  <view class="section-block" wx:if="{{showTestReset}}">
    <view class="section-heading"><text class="section-title">开发版测试工具</text></view>
    <view class="test-reset-card surface-card">
      <text class="setting-title">重新体验新用户流程</text>
      <text class="setting-desc">仅限测试环境。注销当前测试身份并退出已有家谱，重新以空白账户进入。</text>
      <button class="test-reset-button" bindtap="resetTestAccount" loading="{{resettingTestAccount}}" disabled="{{resettingTestAccount || savingAvatar || savingProfile}}">{{resettingTestAccount ? '正在重新进入…' : '注销并重新体验'}}</button>
    </view>
  </view>
</view>
