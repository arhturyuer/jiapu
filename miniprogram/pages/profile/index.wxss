.profile-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.profile-card { padding: 32rpx; display: flex; align-items: flex-start; }
.avatar-column { width: 164rpx; flex: 0 0 164rpx; }
.avatar-button { width: 100%; padding: 0; display: flex; flex-direction: column; align-items: center; background: transparent; }
.avatar-button-active, .avatar-button-busy { opacity: 0.72; }
.profile-avatar { width: 144rpx; height: 144rpx; border-radius: 44rpx; }
.profile-placeholder { display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; font-size: 52rpx; font-weight: 600; }
.avatar-edit { width: 100%; margin-top: 12rpx; color: #245C4A; font-size: 28rpx; line-height: 1.4; text-align: center; }
.avatar-status { width: 172rpx; margin-top: 10rpx; color: #65706A; font-size: 26rpx; line-height: 1.45; text-align: center; transform: translateX(-4rpx); }
.avatar-status-approved { color: #245C4A; }.avatar-status-pending,.avatar-status-uploading,.avatar-status-saving { color: #8A641F; }.avatar-status-rejected,.avatar-status-failed { color: #A14132; }
.avatar-retry { margin-top: 8rpx; color: #A14132; font-size: 28rpx; text-align: center; text-decoration: underline; }
.profile-form { width: calc(100% - 188rpx); min-width: 0; margin-left: 24rpx; }.profile-label { display: block; color: #65706A; font-size: 28rpx; line-height: 1.45; }.profile-sync-tip { margin-top: 10rpx; display: block; color: #65706A; font-size: 26rpx; line-height: 1.45; }
.nickname-input { width: 100%; height: 88rpx; margin-top: 12rpx; padding: 0 20rpx; background: #F3F2EC; border: 2rpx solid #D8DED9; border-radius: 18rpx; text-align: left; font-size: 32rpx; }.save-profile { width: 100%; margin-top: 18rpx; font-size: 30rpx; }
.section-block { margin-top: 40rpx; }.current-family-card { padding: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.current-family-name,.current-family-meta,.current-family-updated { display: block; }.current-family-name { font-size: 36rpx; font-weight: 650; }.current-family-meta { margin-top: 8rpx; color: #65706A; font-size: 28rpx; }.current-family-updated { margin-top: 6rpx; color: #65706A; font-size: 26rpx; }.open-graph-button { min-width: 172rpx; min-height: 88rpx; padding: 0 20rpx; flex: 0 0 auto; font-size: 28rpx; }
.setting-list { padding: 0 24rpx; }.setting-row { min-height: 116rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EEF0ED; }.setting-row:last-child { border-bottom: none; }.setting-row-active { background: #F4F8F5; }.setting-title,.setting-desc { display: block; }.setting-title { font-size: 32rpx; font-weight: 600; }.setting-desc { margin-top: 6rpx; color: #65706A; font-size: 27rpx; line-height: 1.45; }.setting-arrow { color: #9AA39E; font-size: 48rpx; }.version-text { margin-top: 48rpx; display: block; color: #7B8580; font-size: 28rpx; text-align: center; }
.pending-card { padding: 32rpx; display: flex; flex-direction: column; gap: 18rpx; border-color: #E7B66E; }.pending-title { color: #8A5A16; font-size: 36rpx; font-weight: 650; }.pending-desc { color: #765E3A; font-size: 28rpx; line-height: 1.65; }.contact-button,.text-button { min-height: 88rpx; color: #245C4A; background: transparent; font-size: 30rpx; text-decoration: underline; }.profile-empty { min-height: 72vh; }.empty-action { width: 100%; max-width: 520rpx; margin-top: 16rpx; }
.archived-empty-list { width: 100%; max-width: 620rpx; margin-top: 36rpx; padding: 0 24rpx; }
.family-option { min-height: 116rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EEF0ED; }.family-option.selected { background: #E4EFEA; border-radius: 20rpx; }.family-option-name,.family-option-role { display: block; }.family-option-name { font-size: 32rpx; font-weight: 600; }.family-option-role { margin-top: 6rpx; color: #65706A; font-size: 27rpx; }.selected-text { color: #245C4A; font-size: 28rpx; }.create-family-button { width: 100%; margin-top: 28rpx; }
