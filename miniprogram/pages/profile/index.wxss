.profile-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.profile-card { position: relative; min-height: 208rpx; padding: 32rpx; }
.avatar-btn { position: absolute; top: 32rpx; left: 32rpx; width: 144rpx; height: 144rpx; margin: 0; padding: 0; border-radius: 44rpx; overflow: hidden; background: transparent; }
.avatar-btn::after { border: none; }
.avatar-btn-active, .avatar-btn-loading { opacity: 0.72; }
.profile-avatar { width: 144rpx; height: 144rpx; border-radius: 44rpx; }
.profile-placeholder { display: flex; align-items: center; justify-content: center; color: #245C4A; background: #E4EFEA; font-size: 52rpx; font-weight: 600; }
.profile-form { min-height: 144rpx; margin-left: 160rpx; display: flex; flex-direction: column; justify-content: center; gap: 16rpx; }
.nickname-input { width: 100%; height: 88rpx; padding: 0 20rpx; background: #F3F2EC; border: 2rpx solid #D8DED9; border-radius: 18rpx; text-align: left; font-size: 32rpx; }
.save-btn { width: 100%; font-size: 30rpx; }
.section-block { margin-top: 40rpx; }.current-family-card { padding: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.current-family-copy { min-width:0; flex:1; }.current-family-name,.current-family-meta,.current-family-updated,.current-family-membership-detail { display: block; }.current-family-name { overflow:hidden; font-size: 36rpx; font-weight: 650; text-overflow:ellipsis; white-space:nowrap; }.current-family-meta { margin-top: 8rpx; color: #65706A; font-size: 28rpx; }.current-family-updated { margin-top: 6rpx; color: #65706A; font-size: 26rpx; }.current-family-membership-detail { margin-top:12rpx; color:#765E3A; font-size:23rpx; line-height:1.45; }.current-family-membership { min-width:144rpx; padding:18rpx 16rpx; flex:none; color:#654B1B; background:#FFF0CA; border-radius:20rpx; text-align:center; }.current-family-membership.active { color:#FFFFFF; background:#34715D; }.current-family-membership-pressed { opacity:.75; }.current-family-membership-tier,.current-family-membership-action { display:block; }.current-family-membership-tier { font-size:27rpx; font-weight:700; }.current-family-membership-action { margin-top:6rpx; font-size:22rpx; opacity:.86; }
.setting-list { padding: 0 24rpx; }.setting-row { min-height: 116rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EEF0ED; }.setting-row:last-child { border-bottom: none; }.setting-row-active { background: #F4F8F5; }.setting-title,.setting-desc { display: block; }.setting-title { font-size: 32rpx; font-weight: 600; }.setting-desc { margin-top: 6rpx; color: #65706A; font-size: 27rpx; line-height: 1.45; }.setting-arrow { color: #9AA39E; font-size: 48rpx; }
.pending-card { padding: 32rpx; display: flex; flex-direction: column; gap: 18rpx; border-color: #E7B66E; }.pending-title { color: #8A5A16; font-size: 36rpx; font-weight: 650; }.pending-desc { color: #765E3A; font-size: 28rpx; line-height: 1.65; }.contact-button,.text-button { min-height: 88rpx; color: #245C4A; background: transparent; font-size: 30rpx; text-decoration: underline; }.profile-empty { min-height: 72vh; }.empty-guide-actions { width: 100%; max-width: 520rpx; margin-top: 32rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }.empty-action { width: 100%; margin: 0; }.invite-help { margin-top: 12rpx; color: #65706A; font-size: 25rpx; line-height: 1.5; text-align: center; text-decoration: underline; }
.archived-empty-list { width: 100%; max-width: 620rpx; margin-top: 36rpx; padding: 0 24rpx; }
.family-option { min-height: 116rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #EEF0ED; }.family-option.selected { background: #E4EFEA; border-radius: 20rpx; }.family-option-name,.family-option-role { display: block; }.family-option-name { font-size: 32rpx; font-weight: 600; }.family-option-role { margin-top: 6rpx; color: #65706A; font-size: 27rpx; }.selected-text { color: #245C4A; font-size: 28rpx; }.create-family-button { width: 100%; margin-top: 28rpx; }
.banner-ad { margin-top:40rpx; }
