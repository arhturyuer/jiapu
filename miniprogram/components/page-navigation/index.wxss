.navigation-space{flex:none;height:64px;}
.navigation{position:fixed;top:0;left:0;right:0;z-index:29;height:64px;background:#F7F4EC;color:#17231F;}
.navigation-row{position:absolute;top:20px;left:0;right:0;height:44px;display:flex;align-items:center;}
.navigation-title{position:absolute;top:50%;left:12px;right:108px;transform:translateY(-50%);display:block;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-align:left;font-size:17px;font-weight:600;line-height:1.4;}
.navigation-back{position:absolute;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px;min-width:44px;height:44px;margin:0;padding:0;color:#17231F;background:transparent;}
.navigation-back::after{border:0;}
.navigation-home{border-radius:12px;}
.navigation-home[disabled]{background:transparent;opacity:.6;}
.navigation-home-icon{flex:none;width:28px;height:28px;background:transparent;}
.navigation-elder .navigation-home-icon{width:32px;height:32px;}
.navigation-back-icon{flex:none;width:12px;height:12px;margin-left:6px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;border-radius:1px;transform:rotate(45deg);}
.navigation-title-switch{display:flex;align-items:center;justify-content:flex-start;gap:8px;box-sizing:border-box;margin:0;padding:0;color:inherit;background:transparent;border-radius:0;}
.navigation-title-switch::after{border:0;}
.navigation-title-label{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.navigation-switch-icon{position:relative;display:block;flex:none;width:1.1em;height:1.1em;}
.navigation-switch-line{position:absolute;left:10%;width:80%;height:1.5px;border-radius:1px;background:currentColor;}
.navigation-switch-line.is-forward{top:28%;}
.navigation-switch-line.is-backward{bottom:28%;}
.navigation-switch-line::after{content:'';position:absolute;top:50%;width:.28em;height:.28em;border-top:1.5px solid currentColor;border-right:1.5px solid currentColor;}
.navigation-switch-line.is-forward::after{right:0;transform:translateY(-50%) rotate(45deg);}
.navigation-switch-line.is-backward::after{left:0;transform:translateY(-50%) rotate(-135deg);}
.navigation-title-pressed{background:rgba(36,92,74,.06);}
