@import "../../styles/reading.wxss";
.reading-root { min-height:0; }
.date-row { min-height: 100rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 2rpx solid #EEF0ED; }
.date-label { flex-shrink: 0; font-size: var(--reading-font-14, 16px); font-weight: 600; }
.date-value { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; color: #245C4A; font-size: var(--reading-font-13_5, 14px); text-align: right; }
.date-placeholder { color:#65706A; }
.date-arrow { color:#65706A; font-size: var(--reading-font-21, 21px); line-height: 1; }
.date-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; }
.date-mask { position: absolute; inset: 0; background: rgba(28, 39, 33, 0.46); }
.date-panel { position: relative; z-index: 1; width: 100%; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; box-sizing: border-box; }
.date-toolbar { height: 72rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-switch { display: flex; gap: 4rpx; padding: 4rpx; background: #E9EAE4; border-radius: 14rpx; }
.calendar-item { padding: 10rpx 15rpx; color: #65706A; border-radius: 11rpx; font-size: var(--reading-font-12, 14px); }
.calendar-item.selected { color: #245C4A; background: #FFFFFF; font-weight: 600; }
.date-title { font-size: var(--reading-font-14_5, 16px); font-weight: 600; }
.date-cancel { color: #65706A; font-size: var(--reading-font-13, 14px); }
.date-column-labels { display: flex; margin-top: 16rpx; color: #65706A; text-align: center; font-size: var(--reading-font-12, 14px); }
.date-column-labels text { flex: 1; }
.date-wheels { height: 450rpx; }
.date-option { height: 88rpx; display: flex; align-items: center; justify-content: center; color: #26352D; font-size: var(--reading-font-15_5, 16px); }
.date-extra { min-height: 66rpx; display: flex; align-items: center; justify-content: space-between; }
.leap-option { padding: 10rpx 18rpx; color: #245C4A; background: #F3F2EC; border-radius: 14rpx; font-size: var(--reading-font-12_5, 14px); }
.leap-option.selected { background: #E4EFEA; font-weight: 600; }
.date-hint { margin-left: auto; color:#65706A; font-size: var(--reading-font-11_5, 14px); }
.date-actions { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 14rpx; }
.date-actions > text { padding: 20rpx; color: #65706A; font-size: var(--reading-font-13, 14px); }
.date-actions button { flex: 1; min-height: 92rpx; margin: 0; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #245C4A; border-radius: 24rpx; font-size: var(--reading-font-15, 16px); font-weight: 600; letter-spacing: 1rpx; }
/* large-screen:start — generated by scripts/generate-large-screen-styles.mjs */
@media (min-width: 600px) {
  .date-row { min-height: 50px; gap: 10px; border-bottom: 1px solid #EEF0ED; }
  .date-value { gap: 7px; }
  .date-panel { padding: 14px 15px calc(14px + env(safe-area-inset-bottom)); border-radius: 16px 16px 0 0; }
  .date-toolbar { height: 36px; }
  .calendar-switch { gap: 2px; padding: 2px; border-radius: 7px; }
  .calendar-item { padding: 5px 7.5px; border-radius: 5.5px; }
  .date-column-labels { margin-top: 8px; }
  .date-wheels { height: 225px; }
  .date-option { height: 44px; }
  .date-extra { min-height: 33px; }
  .leap-option { padding: 5px 9px; border-radius: 7px; }
  .date-actions { gap: 12px; margin-top: 7px; }
  .date-actions > text { padding: 10px; }
  .date-actions button { min-height: 46px; padding: 0 14px; border-radius: 12px; letter-spacing: 0.5px; }
}
/* large-screen:end */

/* large-screen:layout */
.desktop-date-selectors { display:flex; gap:12px; padding:16px 0; }
.desktop-date-selectors picker { flex:1; min-width:0; }
.desktop-date-option { min-height:44px; padding:12px 6px; border:1px solid #D8DED9; border-radius:10px; text-align:center; color:#245C4A; font-size: var(--reading-font-16, 16px); }
@media (min-width:600px) {
  .date-overlay { align-items:center; justify-content:center; padding:16px; }
  .date-panel { max-width:560px; max-height:calc(100vh - 32px); overflow-y:auto; border-radius:16px; }
  .date-toolbar { height:auto; min-height:44px; flex-wrap:wrap; gap:8px; }
  .date-actions button { min-height:44px; font-size: var(--reading-font-16, 16px); }
}
@media (min-width:600px) and (max-height:520px) {
  .date-wheels { height:140px; }
  .date-panel { padding:12px 16px; }
  .date-extra { flex-wrap:wrap; gap:8px; }
}
