.date-row { min-height: 100rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 2rpx solid #EEF0ED; }
.date-label { flex-shrink: 0; font-size: 28rpx; font-weight: 600; }
.date-value { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; color: #245C4A; font-size: 27rpx; text-align: right; }
.date-placeholder { color: #9AA39E; }
.date-arrow { color: #9AA39E; font-size: 42rpx; line-height: 1; }
.date-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; }
.date-mask { position: absolute; inset: 0; background: rgba(28, 39, 33, 0.46); }
.date-panel { position: relative; z-index: 1; width: 100%; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; box-sizing: border-box; }
.date-toolbar { height: 72rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-switch { display: flex; gap: 4rpx; padding: 4rpx; background: #E9EAE4; border-radius: 14rpx; }
.calendar-item { padding: 10rpx 15rpx; color: #65706A; border-radius: 11rpx; font-size: 24rpx; }
.calendar-item.selected { color: #245C4A; background: #FFFFFF; font-weight: 600; }
.date-title { font-size: 29rpx; font-weight: 600; }
.date-cancel { color: #65706A; font-size: 26rpx; }
.date-column-labels { display: flex; margin-top: 16rpx; color: #65706A; text-align: center; font-size: 24rpx; }
.date-column-labels text { flex: 1; }
.date-wheels { height: 450rpx; }
.date-option { height: 88rpx; display: flex; align-items: center; justify-content: center; color: #26352D; font-size: 31rpx; }
.date-extra { min-height: 66rpx; display: flex; align-items: center; justify-content: space-between; }
.leap-option { padding: 10rpx 18rpx; color: #245C4A; background: #F3F2EC; border-radius: 14rpx; font-size: 25rpx; }
.leap-option.selected { background: #E4EFEA; font-weight: 600; }
.date-hint { margin-left: auto; color: #7B8580; font-size: 23rpx; }
.date-actions { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 14rpx; }
.date-actions > text { padding: 20rpx; color: #65706A; font-size: 26rpx; }
.date-actions button { flex: 1; min-height: 92rpx; margin: 0; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; color: #FFFFFF; background: #245C4A; border-radius: 24rpx; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
