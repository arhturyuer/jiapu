# 复制为 deployment/staging.local.env 后填写。该文件已被 Git 忽略，不存放密钥。
STAGING_ENV_ID=REPLACE_WITH_STAGING_ENV_ID
STAGING_DB_INSTANCE_ID=REPLACE_WITH_STAGING_DATABASE_INSTANCE_ID
STAGING_STORAGE_BUCKET=REPLACE_WITH_STAGING_STORAGE_BUCKET
# 个人套餐不支持 CUSTOM 存储规则时，显式接受 staging 的 PRIVATE 回退。
STAGING_ALLOW_PERSONAL_PRIVATE_STORAGE=0
