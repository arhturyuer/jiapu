# 复制为 deployment/staging.local.env 后填写。该文件已被 Git 忽略，不存放密钥。
STAGING_ENV_ID=REPLACE_WITH_STAGING_ENV_ID
STAGING_DB_INSTANCE_ID=REPLACE_WITH_STAGING_DATABASE_INSTANCE_ID
STAGING_STORAGE_BUCKET=REPLACE_WITH_STAGING_STORAGE_BUCKET
STAGING_BOOTSTRAP_SECRET=REPLACE_WITH_A_STAGING_ONLY_RANDOM_SECRET_AT_LEAST_32_CHARS
# staging 强制使用微信虚拟支付沙箱；不得填写 production 凭据。
STAGING_PAYMENT_MODE=sandbox
STAGING_VP_APP_ID=REPLACE_WITH_SANDBOX_MINIPROGRAM_APP_ID
STAGING_VP_APP_SECRET=REPLACE_WITH_SANDBOX_MINIPROGRAM_APP_SECRET
STAGING_VP_OFFER_ID=REPLACE_WITH_SANDBOX_OFFER_ID
STAGING_VP_APP_KEY=REPLACE_WITH_SANDBOX_APP_KEY
STAGING_VP_INTERNAL_NOTIFY_SECRET=REPLACE_WITH_A_STAGING_ONLY_RANDOM_NOTIFY_SECRET_AT_LEAST_32_CHARS
# 微信公众平台订阅消息配置完成后填写两类模板 ID 与实际 thing/time 字段键；未配置时全部留空。
STAGING_NOTIFY_JOIN_TEMPLATE_ID=
STAGING_NOTIFY_JOIN_MEMBER_KEY=
STAGING_NOTIFY_JOIN_TIME_KEY=
STAGING_NOTIFY_REVIEW_TEMPLATE_ID=
STAGING_NOTIFY_REVIEW_SUBJECT_KEY=
STAGING_NOTIFY_REVIEW_DESCRIPTION_KEY=
# 在云开发控制台的「设置 → 其他设置 → 消息推送」中，将 event/xpay_goods_deliver_notify
# 和 event/xpay_refund_notify 绑定到 staging 的 youpuPaymentNotify。每个事件组合一次只能绑定一个环境。
# 个人套餐不支持 CUSTOM 存储规则时，显式接受 staging 的 PRIVATE 回退。
STAGING_ALLOW_PERSONAL_PRIVATE_STORAGE=0
