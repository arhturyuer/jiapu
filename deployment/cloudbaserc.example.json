{
  "envId": "REPLACE_WITH_STAGING_ENV_ID",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "youpuUserApi",
      "dir": "cloudfunctions/youpuUserApi",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {
        "CONTENT_MODERATION_MODE": "strict",
        "JOB_DISPATCH_SECRET": "REPLACE_WITH_A_RANDOM_SECRET",
        "JOB_FUNCTION_NAMESPACE": "REPLACE_WITH_STAGING_ENV_ID",
        "PAYMENT_MODE": "mock"
      }
    },
    {
      "name": "youpuPaymentNotify",
      "dir": "cloudfunctions/youpuPaymentNotify",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {}
    },
    {
      "name": "youpuOpsApi",
      "dir": "cloudfunctions/youpuOpsApi",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {}
    },
    {
      "name": "youpuJobs",
      "dir": "cloudfunctions/youpuJobs",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 900,
      "memorySize": 512,
      "installDependency": true,
      "envVariables": {
        "BOOTSTRAP_SECRET": "REPLACE_WITH_A_RANDOM_SECRET",
        "JOB_DISPATCH_SECRET": "REPLACE_WITH_A_RANDOM_SECRET"
      },
      "triggers": [
        { "name": "youpu-retention-maintenance", "type": "timer", "config": "0 0 3 * * * *" }
      ]
    }
  ]
}
